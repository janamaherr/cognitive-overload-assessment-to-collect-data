@{
    ViewData["Title"] = "Memory Pattern Challenge";
}

<style>
    body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; }

    .game-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }

    .game-card {
        background: rgba(18, 27, 45, 0.92);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1.5rem;
        max-width: 700px;
        width: 100%;
        color: #fff;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    }

    .section-badge {
        display: inline-block;
        background: linear-gradient(90deg, #e94560, #f5a623);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        margin-bottom: 0.5rem;
    }

    .game-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(90deg, #fff 0%, #a0c4ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .how-to-play { font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.5; }

    .stats-bar {
        background: rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-item { text-align: center; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #f5a623; line-height: 1; }

    .memory-grid {
        display: grid;
        gap: 8px;
        width: 380px;
        height: 380px;
        margin: 0 auto;
    }

    .memory-cell {
        background: rgba(255,255,255,0.1);
        border: 2px solid rgba(255,255,255,0.15);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .memory-cell:hover { background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.35); transform: scale(1.04); }
    .memory-cell.active { background: linear-gradient(135deg, #e94560, #f5a623); border-color: #f5a623; transform: scale(0.95); box-shadow: 0 0 20px rgba(245,166,35,0.6); }
    .memory-cell.clicked { background: rgba(100,200,255,0.4); }
    .memory-cell.correct-click { background: linear-gradient(135deg, #11998e, #38ef7d); border-color: #38ef7d; box-shadow: 0 0 15px rgba(56,239,125,0.5); }
    .memory-cell.wrong-click { background: linear-gradient(135deg, #e94560, #c0392b); border-color: #e94560; box-shadow: 0 0 15px rgba(233,69,96,0.5); }

    .btn-game-primary {
        background: linear-gradient(90deg, #e94560, #f5a623);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(233,69,96,0.4);
    }
    .btn-game-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(233,69,96,0.6); color: #fff; }

    .btn-game-success {
        background: linear-gradient(90deg, #11998e, #38ef7d);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(56,239,125,0.35);
    }
    .btn-game-success:hover { transform: translateY(-2px); color: #fff; }

    .btn-game-secondary {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.8); font-weight: 600;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-game-secondary:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .btn-scoreboard {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.75);
        font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em;
        padding: 0.3rem 0.9rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-scoreboard:hover { background: rgba(255,255,255,0.18); color: #fff; }

    .survey-step {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .survey-scale-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 0.35rem;
    }

    .survey-pill {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.85);
        border-radius: 999px;
        min-width: 42px;
        padding: 0.35rem 0.75rem;
        font-weight: 700;
        transition: all 0.15s ease;
    }

    .btn-check:checked + .survey-pill {
        background: linear-gradient(90deg, #e94560, #f5a623);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(233,69,96,0.35);
    }

    #feedbackMessage {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        min-width: 280px;
        text-align: center;
        border-radius: 50px;
        font-weight: 700;
        padding: 0.6rem 1.5rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
</style>

<div class="game-wrapper">
    <div class="game-card p-4 p-md-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="section-badge">Section 1</span>
                <h1 class="game-title">Memory Pattern Challenge</h1>
                <p class="how-to-play">Watch the sequence of highlighted squares, then repeat it in order.</p>
            </div>
            <button id="openScoreboardBtn" type="button" class="btn btn-scoreboard ms-3 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#scoreboardModal">
                🏆 Scoreboard
            </button>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar mb-4">
            <div class="stat-item">
                <div class="stat-label">Time</div>
                <div class="stat-value"><span id="timer">0</span>s</div>
            </div>
        </div>

        <!-- Feedback -->
        <div id="feedbackMessage" class="alert" style="display:none;"></div>

        <!-- Game Board -->
        <div class="d-flex justify-content-center my-4">
            <div id="gameBoard" class="memory-grid"></div>
        </div>

        <!-- Buttons -->
        <div class="text-center mt-4 d-flex justify-content-center gap-3 flex-wrap">
            <button id="startGameBtn" class="btn btn-game-success btn-lg">▶ Start Game</button>
            <button id="playAgainBtn" class="btn btn-game-secondary btn-lg" style="display:none;">↩ Play Again</button>
            <button id="nextGameBtn" class="btn btn-game-primary btn-lg" style="display:none;">Next Game →</button>
        </div>

        <div id="ml-result-box" style="display:none"></div>
    </div>
</div>

<!-- Section1 Instructions Modal -->
<div class="modal fade" id="section1InstructionsModal" tabindex="-1" aria-labelledby="section1InstructionsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#e94560,#f5a623);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-bold" id="section1InstructionsLabel">🧠 Memory Pattern Challenge</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4" style="font-size:1.1rem;line-height:1.8;">
                <div id="section1InstructionsText" style="animation: fadeIn 0.8s ease-in forwards;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-center">
                <button type="button" id="section1InstructionsStartBtn" class="btn" style="background:linear-gradient(90deg,#e94560,#f5a623);color:#fff;font-weight:700;padding:0.6rem 1.8rem;border:0;border-radius:50px;">Let's Play →</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="postGameSurveyModal" tabindex="-1" aria-labelledby="postGameSurveyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#e94560,#f5a623);border-radius:1.25rem 1.25rem 0 0;">
                <div>
                    <h5 class="modal-title fw-800" id="postGameSurveyModalLabel">Quick Game Reflection</h5>
                    <div style="font-size:0.82rem;opacity:0.85;">Answer a few quick questions before moving on.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <div class="survey-step">
                    <div class="fw-bold mb-2">How frustrated, stressed, or annoyed did you feel?</div>
                    <div class="survey-scale-label"><span>Not at all</span><span>Extremely</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s1-q1-1" value="1"><label class="btn survey-pill" for="s1-q1-1">1</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s1-q1-2" value="2"><label class="btn survey-pill" for="s1-q1-2">2</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s1-q1-3" value="3"><label class="btn survey-pill" for="s1-q1-3">3</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s1-q1-4" value="4"><label class="btn survey-pill" for="s1-q1-4">4</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s1-q1-5" value="5"><label class="btn survey-pill" for="s1-q1-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much time pressure did you feel during this game?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s1-q2-1" value="1"><label class="btn survey-pill" for="s1-q2-1">1</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s1-q2-2" value="2"><label class="btn survey-pill" for="s1-q2-2">2</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s1-q2-3" value="3"><label class="btn survey-pill" for="s1-q2-3">3</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s1-q2-4" value="4"><label class="btn survey-pill" for="s1-q2-4">4</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s1-q2-5" value="5"><label class="btn survey-pill" for="s1-q2-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much mental effort did this game require?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s1-q3-1" value="1"><label class="btn survey-pill" for="s1-q3-1">1</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s1-q3-2" value="2"><label class="btn survey-pill" for="s1-q3-2">2</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s1-q3-3" value="3"><label class="btn survey-pill" for="s1-q3-3">3</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s1-q3-4" value="4"><label class="btn survey-pill" for="s1-q3-4">4</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s1-q3-5" value="5"><label class="btn survey-pill" for="s1-q3-5">5</label>
                    </div>
                </div>
                <div class="survey-step mb-0">
                    <div class="fw-bold mb-2">How successful do you think you were in completing the game?</div>
                    <div class="survey-scale-label"><span>Not successful</span><span>Very successful</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveySuccess" id="s1-q4-1" value="1"><label class="btn survey-pill" for="s1-q4-1">1</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s1-q4-2" value="2"><label class="btn survey-pill" for="s1-q4-2">2</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s1-q4-3" value="3"><label class="btn survey-pill" for="s1-q4-3">3</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s1-q4-4" value="4"><label class="btn survey-pill" for="s1-q4-4">4</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s1-q4-5" value="5"><label class="btn survey-pill" for="s1-q4-5">5</label>
                    </div>
                </div>
                <div id="surveyError" class="text-danger fw-bold mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-between">
                <button type="button" class="btn btn-game-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="submitSurveyBtn" class="btn btn-game-primary">Save & Continue</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="scoreboardModal" tabindex="-1" aria-labelledby="scoreboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#1a1a2e;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(90deg,#e94560,#f5a623);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-800" id="scoreboardModalLabel">🏆 Section 1 — Winners Board</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.5);">Ranked by fastest completion time</span>
                    <button id="clearLeaderboardBtn" class="btn btn-sm" style="background:rgba(233,69,96,0.2);border:1px solid rgba(233,69,96,0.5);color:#e94560;border-radius:50px;">🗑 Clear</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="color:#fff;">
                        <thead style="border-bottom:1px solid rgba(255,255,255,0.1);">
                            <tr style="color:rgba(255,255,255,0.5);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em;">
                                <th class="fw-normal pb-2">Rank</th>
                                <th class="fw-normal pb-2">Player</th>
                                <th class="fw-normal pb-2">Time (s)</th>
                            </tr>
                        </thead>
                        <tbody id="timeScoreboardBody">
                            <tr><td colspan="3" style="color:rgba(255,255,255,0.4);padding:1.5rem 0;text-align:center;">No winners yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section2 Instructions Modal -->
<div class="modal fade" id="section2InstructionsModal" tabindex="-1" aria-labelledby="section2InstructionsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#6c63ff,#48c6ef);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-bold" id="section2InstructionsLabel">🔤 Word Unscrambling Challenge</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4" style="font-size:1.1rem;line-height:1.8;">
                <div id="section2InstructionsText" style="animation: fadeIn 0.8s ease-in; opacity:0;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-center">
                <button type="button" id="section2InstructionsStartBtn" class="btn" style="background:linear-gradient(90deg,#6c63ff,#48c6ef);color:#fff;font-weight:700;padding:0.6rem 1.8rem;border:0;border-radius:50px;">Let's Play →</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/behaviorLogger.js"></script>
    <script src="~/js/mouseSpeed.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@@3.21.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/blazeface@@0.0.7/dist/blazeface.min.js"></script>
    <script src="~/js/headTracker.js"></script>
    <script>
        // Game state
        let gameState = {
            sessionId: sessionStorage.getItem('sessionId'),
            gameType: 'Memory Pattern Challenge',
            sectionNumber: 1,
            startTime: null,
            endTime: null,
            score: 0,
            level: 1,
            sequence: [],
            userSequence: [],
            gridSize: 4,
            showingSequence: false,
            gameStarted: false,
            gameCompleted: false,
            currentAttempts: 0,
            maxAttempts: 3 // Allow 3 attempts per game
        };
        const sessionData = {
            age: Number(sessionStorage.getItem('age') || 0)
        };
        
        // Heart Rate polling
        let liveHeartRate   = null;
        let heartRateBefore = null;
        let hrPollInterval  = null;
        let roundNumber = 1;
        let firstRoundSaved = false;

        async function startHRPolling() {
            liveHeartRate = null;
            heartRateBefore = getStoredNumber('baselineHeartRate');
            console.log('startHRPolling: Read baseline from storage:', heartRateBefore);

            if (heartRateBefore != null) {
                console.log('✓ Baseline HR from index:', heartRateBefore, 'bpm');
            } else {
                console.log('✗ Baseline HR not found in storage, fetching from API');
                // Fallback: if baseline was not read at index, fetch it now
                const fallbackHr = await fetchLatestHR();
                console.log('API fallback returned:', fallbackHr);
                if (fallbackHr != null) {
                    heartRateBefore = fallbackHr;
                    sessionStorage.setItem('baselineHeartRate', String(fallbackHr));
                    localStorage.setItem('baselineHeartRate', String(fallbackHr));
                    console.log('✓ Set baseline from API fallback:', heartRateBefore, 'bpm');
                }
            }

            // Get resting HR at game start
            const initial = await fetchLatestHR();
            if (initial) {
                if (heartRateBefore == null) {
                    heartRateBefore = initial;
                }
                console.log('Resting HR:', heartRateBefore, 'bpm');
            }

            // Poll your website every 30 seconds
            hrPollInterval = setInterval(async () => {
                const hr = await fetchLatestHR();
                if (hr) {
                    liveHeartRate = hr;
                    console.log('Live HR:', liveHeartRate, 'bpm');
                }
            }, 30000);
        }

        async function fetchLatestHR() {
            try {
                const res  = await fetch('/api/GameData/latest-hr');
                const data = await res.json();

                // Only use if data is less than 10 minutes old
                if (data.heartRate && data.ageSeconds < 600) {
                    return data.heartRate;
                }
                return null;
            } catch {
                return null;
            }
        }

        function stopHRPolling() {
            if (hrPollInterval) {
                clearInterval(hrPollInterval);
                hrPollInterval = null;
            }
        }

        // Initialize behavior tracking
        const behaviorLogger = new BehaviorLogger(gameState.sessionId, gameState.sectionNumber);
        const mouseTracker = new MouseSpeedTracker();
        const headTracker = new HeadTracker();
        
        // Timer
        let timerInterval;
        let seconds = 0;
        const timeScoreboard = [];
        let currentSavedGameId = null;
        let pendingSurveyAction = null;
        let pendingMlPayload = null;

        function getStoredNumber(key) {
            const raw = sessionStorage.getItem(key) ?? localStorage.getItem(key);
            if (raw == null || raw === '') return null;
            const parsed = Number(raw);
            return Number.isFinite(parsed) ? parsed : null;
        }
        
        // Test API function
        document.getElementById('testApiBtn')?.addEventListener('click', async function() {
            const resultSpan = document.getElementById('apiTestResult');
            resultSpan.innerHTML = 'Testing...';
            
            try {
                const testResult = {
                    sessionId: sessionStorage.getItem('sessionId') || 'test-session',
                    gameType: 'Test',
                    sectionNumber: 0,
                    startTime: new Date().toISOString(),
                    endTime: new Date().toISOString(),
                    score: 0,
                    totalTimeSeconds: 0,
                    completed: true,
                    behaviorData: {
                        mouseMovements: [],
                        typingEvents: [],
                        hesitationPauses: [],
                        averageMouseSpeed: 0,
                        averageTypingSpeed: 0,
                        averageHeadMovement: 0
                    },
                    gameData: {}
                };
                
                const response = await fetch('/api/GameData/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(testResult)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    resultSpan.innerHTML = '✅ API is working!';
                    resultSpan.style.color = 'green';
                } else {
                    resultSpan.innerHTML = `❌ Error: ${data.error}`;
                    resultSpan.style.color = 'red';
                }
            } catch (error) {
                resultSpan.innerHTML = `❌ Connection failed: ${error.message}`;
                resultSpan.style.color = 'red';
            }
        });
        
        // Start the game
        document.getElementById('startGameBtn').addEventListener('click', async function() {
            await startNewGame();
        });
        
        // Next game button
        document.getElementById('nextGameBtn').addEventListener('click', async function() {
            await openPostGameSurvey('next');
        });
        
        // Play again button
        document.getElementById('playAgainBtn').addEventListener('click', async function() {
            await startNextRound();
        });

        document.getElementById('submitSurveyBtn').addEventListener('click', submitPostGameSurvey);

        document.getElementById('openScoreboardBtn').addEventListener('click', function() {
            fetchLeaderboard();
        });

        // Render the grid on initial page load so players see the squares
        // (cells are inert until the player presses Start Game)
        generateGrid();

        document.getElementById('clearLeaderboardBtn').addEventListener('click', async function() {
            if (!confirm('Clear all leaderboard entries?')) return;
            await fetch('/api/GameData/leaderboard/section1', { method: 'DELETE' });
            fetchLeaderboard();
        });
        
        function showFeedback(message, isSuccess) {
            const feedback = document.getElementById('feedbackMessage');
            feedback.textContent = message;
            feedback.className = isSuccess ? 'alert alert-success' : 'alert alert-danger';
            feedback.style.display = 'block';
            
            // Hide after 2 seconds
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }
        
        async function startNewGame() {
            gameState.startTime = null;
            gameState.gameStarted = true;
            gameState.gameCompleted = false;
            gameState.currentAttempts = 0;
            seconds = 0;
            roundNumber = 1;
            firstRoundSaved = false;
            currentSavedGameId = null;
            pendingSurveyAction = null;
            pendingMlPayload = null;

            document.querySelectorAll('#postGameSurveyModal input[type="radio"]').forEach(input => {
                input.checked = false;
            });
            clearSurveyError();

            document.getElementById('startGameBtn').style.display = 'none';
            document.getElementById('nextGameBtn').style.display = 'none';
            document.getElementById('playAgainBtn').style.display = 'none';
            
            document.getElementById('timer').textContent = '0';
            generateGrid();
            startHRPolling();
            startLevel();
            
            // Start tracking behavior
            mouseTracker.startTracking();
            behaviorLogger.startGame(gameState.gameType);
            await headTracker.startTracking();
            
            console.log('Game initialized. Waiting for player turn to start timing.');
        }
        
        async function startNextRound() {
            if (!gameState.gameStarted) {
                return;
            }

            gameState.startTime = null;
            gameState.gameCompleted = false;
            gameState.currentAttempts = 0;
            gameState.showingSequence = false;
            gameState.sequence = [];
            gameState.userSequence = [];
            seconds = 0;

            document.getElementById('timer').textContent = '0';
            document.getElementById('nextGameBtn').style.display = 'none';
            document.getElementById('playAgainBtn').style.display = 'none';

            document.querySelectorAll('.memory-cell').forEach(cell => {
                cell.classList.remove('active', 'clicked', 'correct-click', 'wrong-click');
                cell.style.pointerEvents = 'auto';
            });

            clearSurveyError();
            generateGrid();
            startLevel();
            console.log('Starting round', roundNumber, 'without saving previous round data again.');
        }

        async function openPostGameSurvey(action) {
            pendingSurveyAction = action;
            clearSurveyError();

            const surveyHr = await fetchLatestHR();
            if (surveyHr != null) {
                sessionStorage.setItem('baselineHeartRate', String(surveyHr));
                localStorage.setItem('baselineHeartRate', String(surveyHr));
                sessionStorage.setItem('section1HeartRate', String(surveyHr));
                localStorage.setItem('section1HeartRate', String(surveyHr));
                console.log('HR refreshed just before survey:', surveyHr, 'bpm');
            }

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal'));
            modal.show();
        }

        function clearSurveyError() {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.style.display = 'none';
                errorEl.textContent = '';
            }
        }

        function showSurveyError(message) {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.style.display = 'block';
            }
        }

        function getSurveyResponses() {
            const readValue = (name) => {
                const selected = document.querySelector(`input[name="${name}"]:checked`);
                return selected ? parseInt(selected.value, 10) : null;
            };

            return {
                frustrationStressAnnoyed: readValue('surveyFrustration'),
                timePressure: readValue('surveyTimePressure'),
                mentalEffort: readValue('surveyMentalEffort'),
                success: readValue('surveySuccess')
            };
        }

        async function submitPostGameSurvey() {
            clearSurveyError();

            if (!currentSavedGameId) {
                showSurveyError('Please wait for the game to save before continuing.');
                return;
            }

            const surveyResponses = getSurveyResponses();
            if (Object.values(surveyResponses).some(value => value == null)) {
                showSurveyError('Please answer all four questions before continuing.');
                return;
            }

            try {
                const response = await fetch('/api/GameData/survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        gameId: currentSavedGameId,
                        surveyResponses: surveyResponses
                    })
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    showSurveyError(data.error || 'Could not save survey answers.');
                    return;
                }

                if (pendingMlPayload) {
                    await sendMLPrediction(
                        pendingMlPayload.gameData,
                        pendingMlPayload.behaviorData,
                        pendingMlPayload.headData
                    );
                    pendingMlPayload = null;
                }

                bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal')).hide();

                if (pendingSurveyAction === 'next') {
                    window.location.href = '/Questions/Section2';
                } else if (pendingSurveyAction === 'replay') {
                    await resetAndPlayAgain();
                }
            } catch (error) {
                showSurveyError(error.message || 'Could not save survey answers.');
            }
        }
        
        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                seconds++;
                document.getElementById('timer').textContent = seconds;
            }, 1000);
        }
        
        function generateGrid() {
            const board = document.getElementById('gameBoard');
            board.innerHTML = '';
            board.style.gridTemplateColumns = `repeat(${gameState.gridSize}, 1fr)`;
            
            for (let i = 0; i < gameState.gridSize * gameState.gridSize; i++) {
                const cell = document.createElement('div');
                cell.className = 'memory-cell';
                cell.dataset.index = i;
                cell.addEventListener('click', handleCellClick);
                board.appendChild(cell);
            }
        }
        
        function startLevel() {
            // Generate sequence - make it a bit challenging but doable
            const sequenceLength = 5; // Fixed length for simplicity
            gameState.sequence = [];
            gameState.userSequence = [];
            gameState.currentAttempts++;

            const totalCells = gameState.gridSize * gameState.gridSize;
            while (gameState.sequence.length < sequenceLength) {
                const next = Math.floor(Math.random() * totalCells);
                // Avoid consecutive duplicates so two flashes on the same cell are never adjacent
                if (gameState.sequence.length === 0 || next !== gameState.sequence[gameState.sequence.length - 1]) {
                    gameState.sequence.push(next);
                }
            }
            
            console.log('Sequence to remember:', gameState.sequence);
            showSequence();
        }
        
        function showSequence() {
            gameState.showingSequence = true;
            
            // Disable clicks during sequence display
            document.querySelectorAll('.memory-cell').forEach(cell => {
                cell.style.pointerEvents = 'none';
            });
            
            // Show "Watch carefully" message
            showFeedback('Watch the sequence carefully!', true);
            
            // Highlight each cell in sequence
            gameState.sequence.forEach((cellIndex, i) => {
                setTimeout(() => {
                    const cell = document.querySelector(`[data-index="${cellIndex}"]`);
                    if (cell) {
                        cell.classList.add('active');
                        
                        setTimeout(() => {
                            cell.classList.remove('active');
                            
                            // Enable clicks after sequence ends
                            if (i === gameState.sequence.length - 1) {
                                setTimeout(() => {
                                    gameState.showingSequence = false;
                                    document.querySelectorAll('.memory-cell').forEach(cell => {
                                        cell.style.pointerEvents = 'auto';
                                    });
                                    // Start persisted timing exactly when the player's turn begins.
                                    gameState.startTime = new Date().toISOString();
                                    // Start timer only when sequence is done and player can begin input.
                                    startTimer();
                                    showFeedback('Your turn! Click the squares in the same order.', true);
                                }, 500);
                            }
                        }, 500);
                    }
                }, i * 800); // 800ms between each highlight
            });
        }
        
        function handleCellClick(e) {
            if (gameState.showingSequence || !gameState.gameStarted || gameState.gameCompleted) return;
            
            const cellIndex = parseInt(e.target.dataset.index);
            const currentPosition = gameState.userSequence.length;
            
            // Visual feedback
            e.target.classList.add('clicked');
            setTimeout(() => {
                e.target.classList.remove('clicked');
            }, 200);
            
            // Check if this click matches the expected sequence
            if (cellIndex === gameState.sequence[currentPosition]) {
                // Correct click
                gameState.userSequence.push(cellIndex);
                e.target.classList.add('correct-click');
                setTimeout(() => {
                    e.target.classList.remove('correct-click');
                }, 300);
                
                // Check if sequence is complete
                if (gameState.userSequence.length === gameState.sequence.length) {
                    completeRound(true);
                }
            } else {
                // Wrong click - show error
                e.target.classList.add('wrong-click');
                setTimeout(() => {
                    e.target.classList.remove('wrong-click');
                }, 300);
                
                showFeedback('❌ Hard Luck! Wrong sequence!', false);
                
                // Show what they clicked vs what was expected
                console.log('Wrong! Expected:', gameState.sequence[currentPosition], 'Got:', cellIndex);
                
                // Game over for this attempt
                completeRound(false);
            }
            
            // Log behavior data
            behaviorLogger.logMouseClick(cellIndex);
        }

        function completeRound(completed) {
            showFeedback(completed ? '🎉 Perfect! You remembered the sequence!' : '❌ Hard Luck! Wrong sequence!', completed);
            gameState.gameCompleted = true;

            document.querySelectorAll('.memory-cell').forEach(cell => {
                cell.style.pointerEvents = 'none';
            });

            clearInterval(timerInterval);

            if (roundNumber === 1) {
                document.getElementById('playAgainBtn').style.display = 'inline-block';
                document.getElementById('nextGameBtn').style.display = 'none';
                updateTimeScoreboard(seconds, completed);
                if (!firstRoundSaved) {
                    firstRoundSaved = true;
                    saveGameData(completed);
                }
            } else if (roundNumber === 2) {
                document.getElementById('playAgainBtn').style.display = 'inline-block';
                document.getElementById('nextGameBtn').style.display = 'none';
            } else {
                document.getElementById('playAgainBtn').style.display = 'none';
                document.getElementById('nextGameBtn').style.display = 'inline-block';
            }

            if (roundNumber < 3) {
                roundNumber++;
            }
        }

        function updateTimeScoreboard(totalTimeSeconds, completed) {
            // Only winners are included in the ranking list.
            if (!completed) {
                return;
            }

            fetchLeaderboard();
        }

        function renderTimeScoreboard() {
            timeScoreboard.sort((a, b) => a.totalTimeSeconds - b.totalTimeSeconds);

            const tbody = document.getElementById('timeScoreboardBody');
            tbody.innerHTML = '';

            if (timeScoreboard.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-muted">No winners yet.</td></tr>';
                return;
            }

            timeScoreboard.forEach((entry, index) => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${entry.playerName}</td>
                    <td>${entry.totalTimeSeconds.toFixed(1)}</td>
                `;
                tbody.appendChild(row);
            });
        }

        async function fetchLeaderboard() {
            try {
                const response = await fetch('/api/GameData/leaderboard/section1');
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to fetch leaderboard:', data.error);
                    return;
                }

                timeScoreboard.length = 0;
                timeScoreboard.push(...(data.leaderboard || []));
                renderTimeScoreboard();
            } catch (error) {
                console.error('Error fetching leaderboard:', error);
            }
        }

        async function sendMLPrediction(gameData, behaviorData, headData) {
            const payload = {
                gameId: gameData.gameId ?? null,
                sessionId: gameData.sessionId ?? gameState.sessionId,
                mouseMovementsCount: behaviorData.mouseMovementsCount ?? 0,
                averageMouseSpeed: behaviorData.averageMouseSpeed ?? 0,
                typingEventsCount: behaviorData.typingEventsCount ?? 0,
                averageTypingSpeed: behaviorData.averageTypingSpeed ?? 0,
                hesitationPausesCount: behaviorData.hesitationPausesCount ?? 0,
                averageHeadMovement: headData.averageHeadMovement ?? 0,
                lookAwayCount: headData.lookAwayCount ?? 0,
                headTiltCount: headData.headTiltCount ?? 0,
                totalTimeSeconds: gameData.totalTimeSeconds ?? 0,
                heartRate: gameData.heartRate ?? null,
                heartRatebefore: gameData.heartRateBefore ?? null,
                heartRateDifference: gameData.heartRateDifference ?? null,
                age: sessionData.age ?? 0,
                gameType: gameData.gameTypeEncoded ?? 0,
                sectionNumber: gameData.sectionNumber ?? 1,
                score: gameData.score ?? 0,
                completed: gameData.completed ? 1 : 0
            };

            try {
                const response = await fetch('/api/GameData/ml-predict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                console.log('ML Result:', result);

                showMLResult(result);
            } catch (err) {
                console.error('ML prediction failed:', err);
            }
        }

        function showMLResult(result) {
            const box = document.getElementById('ml-result-box');
            if (box) {
                box.innerHTML = '';
                box.style.display = 'none';
            }
        }
        
        async function saveGameData(completed) {
            // Log HR sources for debugging
            console.log('=== saveGameData START ===');
            console.log('heartRateBefore variable:', heartRateBefore);
            console.log('sessionStorage baselineHeartRate:', sessionStorage.getItem('baselineHeartRate'));
            console.log('localStorage baselineHeartRate:', localStorage.getItem('baselineHeartRate'));
            console.log('liveHeartRate:', liveHeartRate);

            const fallbackHr = await fetchLatestHR();
            console.log('fallbackHr from API:', fallbackHr);
            const finalHeartRate = liveHeartRate ?? fallbackHr ?? null;

            // Resolve initialHeartRate with multiple fallbacks to be robust:
            // 1) `heartRateBefore` variable (set during startHRPolling or modal start)
            // 2) stored `section1HeartRate` (if previously captured)
            // 3) stored `baselineHeartRate` (from Index)
            // 4) last-resort API fetch
            let initialHeartRate = null;
            if (heartRateBefore != null) {
                initialHeartRate = heartRateBefore;
                console.log('initialHeartRate from variable heartRateBefore:', initialHeartRate);
            } else if (getStoredNumber('section1HeartRate') != null) {
                initialHeartRate = getStoredNumber('section1HeartRate');
                console.log('initialHeartRate from section1HeartRate storage:', initialHeartRate);
            } else if (getStoredNumber('baselineHeartRate') != null) {
                initialHeartRate = getStoredNumber('baselineHeartRate');
                console.log('initialHeartRate from baselineHeartRate storage:', initialHeartRate);
            } else if (fallbackHr != null) {
                initialHeartRate = fallbackHr;
                console.log('initialHeartRate from fallback API fetch:', initialHeartRate);
            } else {
                console.log('initialHeartRate could not be resolved from any source');
            }

            console.log('Final computed values - initialHeartRate:', initialHeartRate, 'finalHeartRate:', finalHeartRate);
            console.log('=== saveGameData END LOG ===');

            // Stop HR polling after we sampled the latest values
            stopHRPolling();

            // Stop tracking
            mouseTracker.stopTracking();
            headTracker.stopTracking();
            const mouseData = mouseTracker.getData();
            const headData = headTracker.getData();
            
            // Collect behavior data
            const behaviorData = behaviorLogger.endGame();
            
            // Fix: Ensure all dates in hesitationPauses are proper ISO strings and filter out incomplete pauses
            if (behaviorData.hesitationPauses) {
                behaviorData.hesitationPauses = behaviorData.hesitationPauses
                    .filter(pause => pause.endTime != null) // Only include completed pauses
                    .map(pause => ({
                        ...pause,
                        startTime: pause.startTime ? new Date(pause.startTime).toISOString() : null,
                        endTime: pause.endTime ? new Date(pause.endTime).toISOString() : null
                    }));
            }

            // Keep hesitation pauses bounded to avoid large array documents.
            const boundedHesitationPauses = (behaviorData.hesitationPauses || []).slice(-30);
            
            console.log("Ending game...");
            console.log("Game State:", gameState);
            
            // Prepare game result
            const gameResult = {
                sessionId: gameState.sessionId,
                gameType: gameState.gameType,
                sectionNumber: gameState.sectionNumber,
                startTime: gameState.startTime || new Date(Date.now() - (seconds * 1000)).toISOString(),
                endTime: new Date().toISOString(),
                score: 0,
                surveyavg: 0,
                totalTimeSeconds: seconds,
                completed: completed,
                behaviorData: {
                    // Store only compact fields for query/index efficiency.
                    mouseMovements: mouseData.movements || [],
                    typingEvents: behaviorData.typingEvents || [],
                    hesitationPauses: boundedHesitationPauses,
                    averageMouseSpeed: mouseData.averageSpeed || 0,
                    averageTypingSpeed: behaviorData.averageTypingSpeed || 0,
                    averageHeadMovement: headData.averageHeadMovement || 0,
                    lookAwayCount: headData.lookAwayCount || 0,
                    headTiltCount: headData.tiltCount || 0,
                    heartRate: finalHeartRate,
                    heartRateDifference: (finalHeartRate != null && initialHeartRate != null) ? finalHeartRate - initialHeartRate : null,
                    heartRatebefore: initialHeartRate
                },
                gameData: {
                    gridSize: gameState.gridSize,
                    sequenceShown: gameState.sequence,
                    sequenceClicked: gameState.userSequence,
                    correctClicks: gameState.userSequence.filter((val, idx) => val === gameState.sequence[idx]).length,
                    totalAttempts: gameState.currentAttempts
                }
            };
            
            console.log("Sending game result:", gameResult);
            
            // Save to MongoDB
            try {
                const response = await fetch('/api/GameData/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(gameResult)
                });
                
                const data = await response.json();
                console.log("Server response:", data);
                
                if (data.success) {
                    console.log("Game data saved successfully!");
                    currentSavedGameId = data.id;
                    if (finalHeartRate != null) {
                        sessionStorage.setItem('section1HeartRate', String(finalHeartRate));
                        localStorage.setItem('section1HeartRate', String(finalHeartRate));
                    }

                    await sendMLPrediction(
                        {
                            gameId: data.id,
                            sessionId: gameResult.sessionId,
                            totalTimeSeconds: gameResult.totalTimeSeconds,
                            heartRate: gameResult.behaviorData.heartRate,
                            heartRateBefore: gameResult.behaviorData.heartRatebefore,
                            heartRateDifference: gameResult.behaviorData.heartRateDifference,
                            gameTypeEncoded: 1,
                            sectionNumber: gameResult.sectionNumber,
                            score: gameResult.score,
                            completed: gameResult.completed
                        },
                        {
                            mouseMovementsCount: (gameResult.behaviorData.mouseMovements || []).length,
                            averageMouseSpeed: gameResult.behaviorData.averageMouseSpeed,
                            typingEventsCount: (gameResult.behaviorData.typingEvents || []).length,
                            averageTypingSpeed: gameResult.behaviorData.averageTypingSpeed,
                            hesitationPausesCount: (gameResult.behaviorData.hesitationPauses || []).length
                        },
                        {
                            averageHeadMovement: gameResult.behaviorData.averageHeadMovement,
                            lookAwayCount: gameResult.behaviorData.lookAwayCount,
                            headTiltCount: gameResult.behaviorData.headTiltCount
                        }
                    );
                    if (completed) {
                        fetchLeaderboard();
                    }
                } else {
                    console.error("Failed to save:", data.error);
                }
            } catch (error) {
                console.error('Error saving game data:', error);
            }
        }

        // Show instructions modal on page load
        document.addEventListener('DOMContentLoaded', function() {
            const instructionsText = document.getElementById('section1InstructionsText');
            instructionsText.innerHTML = `
                <p><strong>Watch and repeat!</strong></p>
                <p>A sequence of colored squares will flash in order.</p>
                <p>Pay close attention, then click the squares in the exact same order.</p>
                <p>You have 3 trials to get it right. The sequence will always be 5 squares, but they can appear anywhere on the grid.</p>
                <p>Good luck on your first challenge, and have fun playing!</p>
            `;
            
            const modal = new bootstrap.Modal(document.getElementById('section1InstructionsModal'));
            
            document.getElementById('section1InstructionsStartBtn').onclick = async function() {
                try {
                    // small retry to capture baseline HR at the moment the user begins Section1
                    const retries = 5;
                    const delayMs = 300;
                    let captured = null;
                    for (let i = 0; i < retries; i++) {
                        try {
                            captured = await fetchLatestHR();
                            console.log(`Section1 fetchLatestHR attempt ${i + 1}/${retries}:`, captured);
                            if (captured != null) break;
                        } catch (e) {
                            console.warn('Section1 fetchLatestHR error', e);
                        }
                        await new Promise(r => setTimeout(r, delayMs));
                    }

                    if (captured != null) {
                        sessionStorage.setItem('baselineHeartRate', String(captured));
                        localStorage.setItem('baselineHeartRate', String(captured));
                        console.log('Section1: Stored baselineHeartRate from modal start:', captured);
                    } else {
                        console.log('Section1: No baseline HR captured on modal start.');
                    }
                } catch (e) {
                    console.warn('Error reading HR on Section1 modal start', e);
                } finally {
                    modal.hide();
                }
            };
            
            modal.show();
        });
    </script>
}

