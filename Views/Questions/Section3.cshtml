@{
    ViewData["Title"] = "Twisty Arrow Game";
}

<style>
    body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; }

    .game-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }

    .game-card {
        background: rgba(18, 27, 45, 0.92);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1.5rem;
        max-width: 620px;
        width: 100%;
        color: #fff;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    }

    .section-badge {
        display: inline-block;
        background: linear-gradient(90deg, #f5a623, #f04e23);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        margin-bottom: 0.5rem;
    }

    .game-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(90deg, #fff 0%, #ffd4a0 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .how-to-play { font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.5; }

    .stats-bar {
        background: rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .stat-item { text-align: center; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #f5a623; line-height: 1; }

    #gameCanvas {
        border-radius: 1rem;
        border: 2px solid rgba(255,255,255,0.15);
        box-shadow: 0 0 14px rgba(245,166,35,0.12);
        background: #0d1b2a;
        max-width: 100%;
    }

    .btn-game-primary {
        background: linear-gradient(90deg, #f5a623, #f04e23);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(245,166,35,0.4);
    }
    .btn-game-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(245,166,35,0.6); color: #fff; }
    .btn-game-primary:disabled { opacity: 0.4; transform: none; }

    .btn-game-success {
        background: linear-gradient(90deg, #11998e, #38ef7d);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(56,239,125,0.35);
    }
    .btn-game-success:hover { transform: translateY(-2px); color: #fff; }
    .btn-game-success:disabled { opacity: 0.4; transform: none; }

    .btn-game-secondary {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.8); font-weight: 600;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-game-secondary:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .btn-scoreboard {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.75);
        font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em;
        padding: 0.3rem 0.9rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-scoreboard:hover { background: rgba(255,255,255,0.18); color: #fff; }

    .survey-step {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .survey-scale-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 0.35rem;
    }

    .survey-pill {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.85);
        border-radius: 999px;
        min-width: 42px;
        padding: 0.35rem 0.75rem;
        font-weight: 700;
        transition: all 0.15s ease;
    }

    .btn-check:checked + .survey-pill {
        background: linear-gradient(90deg, #f5a623, #f04e23);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(245,166,35,0.35);
    }

    .head-tracking-toggle {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 0.75rem;
        padding: 0.6rem 1rem;
        color: rgba(255,255,255,0.6);
        font-size: 0.82rem;
    }

    #feedbackMessage {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        min-width: 280px;
        text-align: center;
        border-radius: 50px;
        font-weight: 700;
        padding: 0.6rem 1.5rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    #section3InstructionsText {
        animation: fadeIn 0.8s ease-in forwards;
    }
</style>

<div class="game-wrapper">
    <div class="game-card p-4 p-md-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="section-badge">Section 3</span>
                <h1 class="game-title">Twisty Arrow Game</h1>
                <p class="how-to-play">Shoot arrows into the rotating circle. Don't hit the existing ones!</p>
            </div>
            <button id="openScoreboardBtn" type="button" class="btn btn-scoreboard ms-3 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#section3ScoreboardModal">
                🏆 Scoreboard
            </button>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar mb-4">
            <div class="stat-item">
                <div class="stat-label">Arrows Stuck</div>
                <div class="stat-value"><span id="arrowCount">0</span></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Best</div>
                <div class="stat-value"><span id="bestScore">0</span></div>
            </div>
        </div>

        <!-- Feedback -->
        <div id="feedbackMessage" class="alert" style="display:none;"></div>

        <!-- Canvas -->
        <div class="text-center mb-4">
            <canvas id="gameCanvas" width="500" height="520"></canvas>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-center gap-3 flex-wrap mb-3">
            <button id="startGameBtn" class="btn btn-game-success btn-lg">▶ Start Game</button>
            <button id="shootBtn" class="btn btn-game-primary btn-lg" disabled>🎯 Press Space</button>
            <button id="playAgainBtn" class="btn btn-game-secondary btn-lg" style="display:none;">Play Again</button>
        </div>

        <div id="ml-result-box" style="display:none"></div>

        <!-- Head Tracking Toggle -->
        <div class="head-tracking-toggle d-flex align-items-center gap-2">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="headTrackingToggle">
                <label class="form-check-label" for="headTrackingToggle">Enable head tracking <span style="opacity:0.6;">(may reduce performance)</span></label>
            </div>
        </div>
    </div>
</div>

<!-- Section3 Instructions Modal -->
<div class="modal fade" id="section3InstructionsModal" tabindex="-1" aria-labelledby="section3InstructionsLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#f5a623,#f04e23);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-bold" id="section3InstructionsLabel">🎯 Twisty Arrow Game</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4" style="font-size:1.1rem;line-height:1.8;">
                <div id="section3InstructionsText" style="animation: fadeIn 0.8s ease-in forwards;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-center">
                <button type="button" id="section3InstructionsStartBtn" class="btn" style="background:linear-gradient(90deg,#f5a623,#f04e23);color:#fff;font-weight:700;padding:0.6rem 1.8rem;border:0;border-radius:50px;">Ok!</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="postGameSurveyModal" tabindex="-1" aria-labelledby="postGameSurveyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#f5a623,#f04e23);border-radius:1.25rem 1.25rem 0 0;">
                <div>
                    <h5 class="modal-title fw-800" id="postGameSurveyModalLabel">🎮 Quick Game Reflection</h5>
                    <div style="font-size:0.82rem;opacity:0.85;">Answer a few quick questions before replaying.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <div class="survey-step">
                    <div class="fw-bold mb-2">How frustrated, stressed, or annoyed did you feel?</div>
                    <div class="survey-scale-label"><span>Not at all</span><span>Extremely</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s3-q1-1" value="1"><label class="btn survey-pill" for="s3-q1-1">1</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s3-q1-2" value="2"><label class="btn survey-pill" for="s3-q1-2">2</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s3-q1-3" value="3"><label class="btn survey-pill" for="s3-q1-3">3</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s3-q1-4" value="4"><label class="btn survey-pill" for="s3-q1-4">4</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s3-q1-5" value="5"><label class="btn survey-pill" for="s3-q1-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much time pressure did you feel during this game?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s3-q2-1" value="1"><label class="btn survey-pill" for="s3-q2-1">1</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s3-q2-2" value="2"><label class="btn survey-pill" for="s3-q2-2">2</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s3-q2-3" value="3"><label class="btn survey-pill" for="s3-q2-3">3</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s3-q2-4" value="4"><label class="btn survey-pill" for="s3-q2-4">4</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s3-q2-5" value="5"><label class="btn survey-pill" for="s3-q2-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much mental effort did this game require?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s3-q3-1" value="1"><label class="btn survey-pill" for="s3-q3-1">1</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s3-q3-2" value="2"><label class="btn survey-pill" for="s3-q3-2">2</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s3-q3-3" value="3"><label class="btn survey-pill" for="s3-q3-3">3</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s3-q3-4" value="4"><label class="btn survey-pill" for="s3-q3-4">4</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s3-q3-5" value="5"><label class="btn survey-pill" for="s3-q3-5">5</label>
                    </div>
                </div>
                <div class="survey-step mb-0">
                    <div class="fw-bold mb-2">How successful do you think you were in completing the game?</div>
                    <div class="survey-scale-label"><span>Not successful</span><span>Very successful</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveySuccess" id="s3-q4-1" value="1"><label class="btn survey-pill" for="s3-q4-1">1</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s3-q4-2" value="2"><label class="btn survey-pill" for="s3-q4-2">2</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s3-q4-3" value="3"><label class="btn survey-pill" for="s3-q4-3">3</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s3-q4-4" value="4"><label class="btn survey-pill" for="s3-q4-4">4</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s3-q4-5" value="5"><label class="btn survey-pill" for="s3-q4-5">5</label>
                    </div>
                </div>
                <div id="surveyError" class="text-danger fw-bold mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-between">
                <button type="button" class="btn btn-game-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="submitSurveyBtn" class="btn btn-game-primary">Save Survey</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="section3ScoreboardModal" tabindex="-1" aria-labelledby="section3ScoreboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#1a1a2e;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(90deg,#f5a623,#f04e23);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-800" id="section3ScoreboardModalLabel">🏆 Section 3 — Top Archers</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.5);">Ranked by highest score</span>
                    <button id="clearSection3LeaderboardBtn" class="btn btn-sm" style="background:rgba(233,69,96,0.2);border:1px solid rgba(233,69,96,0.5);color:#e94560;border-radius:50px;">🗑 Clear</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="color:#fff;">
                        <thead style="border-bottom:1px solid rgba(255,255,255,0.1);">
                            <tr style="color:rgba(255,255,255,0.5);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em;">
                                <th class="fw-normal pb-2">Rank</th>
                                <th class="fw-normal pb-2">Player</th>
                                <th class="fw-normal pb-2">Score</th>
                                <th class="fw-normal pb-2">Time (s)</th>
                            </tr>
                        </thead>
                        <tbody id="section3ScoreboardBody">
                            <tr><td colspan="4" style="color:rgba(255,255,255,0.4);padding:1.5rem 0;text-align:center;">No records yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/behaviorLogger.js"></script>
    <script src="~/js/mouseSpeed.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@@3.21.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/blazeface@@0.0.7/dist/blazeface.min.js"></script>
    <script src="~/js/headTracker.js"></script>
    <script>
        // Game state
        let gameState = {
            sessionId: sessionStorage.getItem('sessionId'),
            gameType: 'Twisty Arrow Game',
            sectionNumber: 3,
            startTime: null,
            endTime: null,
            arrowsStuck: 0,
            bestScore: parseInt(localStorage.getItem('twistyArrowBest')) || 0,
            gameStarted: false,
            gameCompleted: false,
            gameLost: false,
            arrowsShot: 0,
            failedAttempts: 0,
            arrowThrows: []
        };
        const sessionData = {
            age: Number(sessionStorage.getItem('age') || 0)
        };

        // Heart Rate polling
        let liveHeartRate   = null;
        let heartRateBefore = null;
        let hrPollInterval  = null;
        let roundNumber = 1;
        let firstRoundSaved = false;

        async function startHRPolling() {
            liveHeartRate = null;
            heartRateBefore = getStoredNumber('section2HeartRate')
                ?? getStoredNumber('section1HeartRate')
                ?? getStoredNumber('baselineHeartRate');

            if (heartRateBefore != null) {
                console.log('Initial HR from previous step:', heartRateBefore, 'bpm');
            }

            // Get resting HR at game start
            const initial = await fetchLatestHR();
            if (initial) {
                if (heartRateBefore == null) {
                    heartRateBefore = initial;
                }
                console.log('Resting HR:', heartRateBefore, 'bpm');
            }

            // Poll your website every 30 seconds
            hrPollInterval = setInterval(async () => {
                const hr = await fetchLatestHR();
                if (hr) {
                    liveHeartRate = hr;
                    console.log('Live HR:', liveHeartRate, 'bpm');
                }
            }, 30000);
        }

        async function fetchLatestHR() {
            try {
                const res  = await fetch('/api/GameData/latest-hr');
                const data = await res.json();

                // Only use if data is less than 10 minutes old
                if (data.heartRate) {
                    return data.heartRate;
                }
                return null;
            } catch {
                return null;
            }
        }

        function stopHRPolling() {
            if (hrPollInterval) {
                clearInterval(hrPollInterval);
                hrPollInterval = null;
            }
        }

        async function startNextRound() {
            gameState.startTime = null;
            gameState.endTime = null;
            gameState.gameStarted = true;
            gameState.gameCompleted = false;
            gameState.gameLost = false;
            gameState.arrowsShot = 0;
            gameState.arrowsStuck = 0;
            gameState.failedAttempts = 0;
            gameState.arrowThrows = [];

            arrows = [];
            rotationAngle = 0;
            flyingArrow = null;

            document.getElementById('arrowCount').textContent = '0';
            document.getElementById('shootBtn').disabled = false;
            document.getElementById('playAgainBtn').style.display = 'none';
            clearSurveyError();

            startHRPolling();

            mouseTracker.startTracking();
            behaviorLogger.startGame(gameState.gameType);
            if (isHeadTrackingEnabled) {
                await headTracker.startTracking();
            }

            if (animationFrame) cancelAnimationFrame(animationFrame);
            draw();
        }

        // Canvas setup
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const centerX = canvas.width / 2;
        const centerY = 280;
        const circleRadius = 110;

        // Game variables
        let rotationAngle = 0;
        const rotationSpeed = 0.02;
        let arrows = [];
        let flyingArrow = null;
        let animationFrame;
        
        // Tracking
        let behaviorLogger;
        let mouseTracker;
        let headTracker;
        let isHeadTrackingEnabled = true;
        const section3Leaderboard = [];
        let currentSavedGameId = null;
        let pendingSurveyAction = null;
        let pendingMlPayload = null;

        function getStoredNumber(key) {
            const raw = sessionStorage.getItem(key);
            if (raw == null || raw === '') return null;
            const parsed = Number(raw);
            return Number.isFinite(parsed) ? parsed : null;
        }

        // Verify session
        if (!gameState.sessionId) {
            alert('No session found. Please start from the homepage.');
            window.location.href = '/';
        }

        // Update best score
        document.getElementById('bestScore').textContent = gameState.bestScore;
        document.getElementById('openScoreboardBtn').addEventListener('click', fetchSection3Leaderboard);

        document.getElementById('clearSection3LeaderboardBtn').addEventListener('click', async function() {
            if (!confirm('Clear all leaderboard entries?')) return;
            await fetch('/api/GameData/leaderboard/section3', { method: 'DELETE' });
            fetchSection3Leaderboard();
        });
        const headTrackingToggle = document.getElementById('headTrackingToggle');
        if (headTrackingToggle) {
            headTrackingToggle.checked = true;
            headTrackingToggle.addEventListener('change', (e) => {
                isHeadTrackingEnabled = e.target.checked;
            });
        }

        // Arrow class
        // adjust this constant to fine-tune how close arrows can be before colliding
        const COLLISION_MARGIN = 0.1; // radians (~5.7 degrees), smaller = more precise

        class StuckArrow {
            constructor(angle,rotationAtTimeOfStick) {
                this.angle = angle;
                this.absoluteAngle = (angle + rotationAtTimeOfStick) % (Math.PI * 2);
                this.relativeAngle = angle % (Math.PI * 2);
                this.length = 38;
                this.color = this.getRandomColor();
                this.headColor = this.darkenColor(this.color);
            }

            getRandomColor() {
                const colors = [
                    '#FF4444', // Red
                    '#44FF44', // Green
                    '#4444FF', // Blue
                    '#FFFF44', // Yellow
                    '#FF44FF', // Purple
                    '#44FFFF', // Cyan
                    '#FF8844', // Orange
                    '#8844FF'  // Violet
                ];
                return colors[Math.floor(Math.random() * colors.length)];
            }

            darkenColor(color) {
                if (color === '#FF4444') return '#CC0000';
                if (color === '#44FF44') return '#00CC00';
                if (color === '#4444FF') return '#0000CC';
                if (color === '#FFFF44') return '#CCCC00';
                if (color === '#FF44FF') return '#CC00CC';
                if (color === '#44FFFF') return '#00CCCC';
                if (color === '#FF8844') return '#CC5500';
                if (color === '#8844FF') return '#5500CC';
                return '#666666';
            }

            draw(ctx, centerX, centerY, radius, rotationAngle) {
                //const effectiveAngle = this.absoluteAngle;
                //const effectiveAngle = this.absoluteAngle + rotationAngle;
                // const effectiveAngle = this.angle + rotationAngle;
                 //const effectiveAngle = (this.relativeAngle + currentRotation) % (Math.PI * 2);
                 const effectiveAngle = (this.relativeAngle + rotationAngle) % (Math.PI * 2);
                // Arrow head position (on the circle)
                const headX = centerX + radius * Math.cos(effectiveAngle);
                const headY = centerY + radius * Math.sin(effectiveAngle);
                
                // Arrow tail position (inside the circle)
                const tailX = centerX + (radius - this.length) * Math.cos(effectiveAngle);
                const tailY = centerY + (radius - this.length) * Math.sin(effectiveAngle);
                
                // Draw arrow line
                ctx.beginPath();
                ctx.moveTo(tailX, tailY);
                ctx.lineTo(headX, headY);
                ctx.strokeStyle = this.color;
                ctx.lineWidth = 6;
                ctx.stroke();
                
                // Draw arrow head
                ctx.save();
                ctx.translate(headX, headY);
                ctx.rotate(effectiveAngle);
                
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.lineTo(-12, -6);
                ctx.lineTo(-12, 6);
                ctx.closePath();
                ctx.fillStyle = this.headColor;
                ctx.fill();
                
                ctx.restore();
            }

        collidesWith(newArrowRelativeAngle, currentRotation, margin = COLLISION_MARGIN) {
        // Calculate current absolute angle of this arrow
        const thisAbsoluteAngle = (this.relativeAngle + currentRotation) % (Math.PI * 2);
        
        // Calculate absolute angle of new arrow (it's hitting NOW at currentRotation)
        const newAbsoluteAngle = (newArrowRelativeAngle + currentRotation) % (Math.PI * 2);
        
        // Compare absolute angles
        let angleDiff = Math.abs(thisAbsoluteAngle - newAbsoluteAngle);
        angleDiff = Math.min(angleDiff, Math.PI * 2 - angleDiff);
        return angleDiff < margin;
    }
        }

        // Flying arrow class
        class FlyingArrow {
            constructor() {
                this.x = centerX;
                this.y = canvas.height - 60;
                this.speed = 7;
                this.angle = null;
                this.active = true;
                this.trail = [];
            }

            update() {
                if (!this.active) return false;
                
                // Add to trail
                this.trail.push({ x: this.x, y: this.y });
                if (this.trail.length > 5) this.trail.shift();
                
                this.y -= this.speed;
                
                // Check if hit the circle
                const dx = this.x - centerX;
                const dy = this.y - centerY;
                const distance = Math.sqrt(dx*dx + dy*dy);
                
                if (distance <= circleRadius + 3) {
                    // Hit the circle!
                    this.active = false;
                    this.angle = Math.atan2(dy, dx);
                    return true;
                }
                
                // Check if went past circle (missed)
                if (this.y < centerY - circleRadius - 40) {
                    this.active = false;
                    return false;
                }
                
                return null;
            }

            draw(ctx) {
                if (!this.active) return;
                
                // Draw trail
                for (let i = 0; i < this.trail.length; i++) {
                    const point = this.trail[i];
                    const alpha = i / this.trail.length * 0.5;
                    
                    ctx.save();
                    ctx.translate(point.x, point.y);
                    
                    ctx.beginPath();
                    ctx.arc(0, 0, 3, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(0, 0, 0, ${alpha})`;
                    ctx.fill();
                    
                    ctx.restore();
                }
                
                // Draw arrow
                ctx.save();
                ctx.translate(this.x, this.y);
                
                // Draw arrow pointing up
                ctx.rotate(-Math.PI / 2);
                
                ctx.beginPath();
                ctx.moveTo(0, 0);
                ctx.lineTo(20, -6);
                ctx.lineTo(20, 6);
                ctx.closePath();
                ctx.fillStyle = '#000000';
                ctx.shadowColor = 'rgba(0,0,0,0.3)';
                ctx.shadowBlur = 5;
                ctx.fill();
                
                ctx.restore();
            }
        }

        // Draw the game
        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw bow platform
            ctx.beginPath();
            ctx.moveTo(centerX - 70, canvas.height - 40);
            ctx.lineTo(centerX, canvas.height - 20);
            ctx.lineTo(centerX + 70, canvas.height - 40);
            ctx.fillStyle = '#8B4513';
            ctx.fill();
            
            // Draw rotating circle
            ctx.save();
            ctx.translate(centerX, centerY);
            ctx.rotate(rotationAngle);
            
            ctx.beginPath();
            ctx.arc(0, 0, circleRadius, 0, Math.PI * 2);
            ctx.strokeStyle = '#333';
            ctx.lineWidth = 3;
            ctx.stroke();
            
            ctx.fillStyle = 'rgba(200, 200, 200, 0.2)';
            ctx.fill();
            
            ctx.restore();
            
            // Draw arrows count in center
            ctx.save();
            ctx.font = 'bold 48px Arial';
            ctx.fillStyle = '#333';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(gameState.arrowsStuck, centerX, centerY);
            ctx.restore();
            
            // Draw stuck arrows
            arrows.forEach(arrow => {
                arrow.draw(ctx, centerX, centerY, circleRadius, rotationAngle);
            });
            
            // Draw and update flying arrow in the main RAF loop to avoid a second animation loop.
            if (flyingArrow && flyingArrow.active) {
                const result = flyingArrow.update();
                flyingArrow.draw(ctx);

                if (result === true) {
                    handleArrowHit();
                } else if (result === false) {
                    handleArrowMiss();
                }
            }
            
            // Update rotation
            rotationAngle += rotationSpeed;
            
            if (gameState.gameStarted && !gameState.gameCompleted) {
                animationFrame = requestAnimationFrame(draw);
            }
        }

        // Shoot arrow
        function shootArrow() {
            if (!gameState.gameStarted || gameState.gameCompleted || gameState.gameLost) return;
            if (flyingArrow && flyingArrow.active) {
                showFeedback('Wait for arrow to hit!', false);
                return;
            }
            
            gameState.arrowsShot++;
            flyingArrow = new FlyingArrow();
        }

        function handleArrowHit() {
            const hitAngle = flyingArrow.angle;
            const relativeAngle = hitAngle - rotationAngle;

            let collision = false;
            for (let arrow of arrows) {
                if (arrow.collidesWith(relativeAngle, rotationAngle)) {
                    collision = true;
                    break;
                }
            }

            gameState.arrowThrows.push({
                timestamp: new Date().toISOString(),
                angle: relativeAngle,
                hitAnotherArrow: collision,
                rotationSpeed: rotationSpeed
            });

            if (collision) {
                gameState.failedAttempts++;
                gameState.gameLost = true;
                gameState.gameCompleted = true;
                showFeedback('💥 GAME OVER! Hit another arrow!', false);
                flyingArrow = null;
                endGame(false);
            } else {
                gameState.arrowsStuck++;
                arrows.push(new StuckArrow(relativeAngle, rotationAngle));
                document.getElementById('arrowCount').textContent = gameState.arrowsStuck;
                showFeedback('✓ Arrow #' + gameState.arrowsStuck + ' stuck!', true);
                flyingArrow = null;
            }
        }

        function handleArrowMiss() {
            gameState.failedAttempts++;
            gameState.arrowThrows.push({
                timestamp: new Date().toISOString(),
                angle: null,
                hitAnotherArrow: false,
                rotationSpeed: rotationSpeed
            });
            showFeedback('Missed!', false);
            flyingArrow = null;
        }

        // Start game
        async function startGame() {
            if (!behaviorLogger || !mouseTracker || !headTracker) {
                behaviorLogger = new BehaviorLogger(gameState.sessionId, gameState.sectionNumber);
                mouseTracker = new MouseSpeedTracker();
                headTracker = new HeadTracker();
            }
            
            roundNumber = 1;
            firstRoundSaved = false;
            gameState.startTime = new Date().toISOString();
            gameState.gameStarted = true;
            gameState.gameCompleted = false;
            gameState.gameLost = false;
            gameState.arrowsShot = 0;
            gameState.arrowsStuck = 0;
            gameState.failedAttempts = 0;
            gameState.arrowThrows = [];
            currentSavedGameId = null;
            pendingSurveyAction = null;
            
            arrows = [];
            rotationAngle = 0;
            
            document.getElementById('arrowCount').textContent = '0';
            document.getElementById('startGameBtn').style.display = 'none';
            // Keep the on-screen shoot button informational (disabled) so players must press Space to fire.
            const shootBtnEl = document.getElementById('shootBtn');
            if (shootBtnEl) {
                shootBtnEl.disabled = true;
                shootBtnEl.setAttribute('aria-disabled', 'true');
                shootBtnEl.style.pointerEvents = 'none';
                shootBtnEl.style.cursor = 'default';
            }
            document.getElementById('playAgainBtn').style.display = 'none';
            
            // Start HR polling
            startHRPolling();
            
            mouseTracker.startTracking();
            behaviorLogger.startGame(gameState.gameType);
            if (isHeadTrackingEnabled) {
                await headTracker.startTracking();
            }
            
            if (animationFrame) cancelAnimationFrame(animationFrame);
            draw();
            
        }

        // End game
        async function endGame(completed) {
            gameState.endTime = new Date().toISOString();
            document.getElementById('shootBtn').disabled = true;

            if (roundNumber === 1) {
                if (!firstRoundSaved) {
                    firstRoundSaved = true;
                    await saveGameData(completed);
                }
                document.getElementById('playAgainBtn').style.display = 'inline-block';
                roundNumber = 2;
                return;
            }

            if (roundNumber === 2) {
                document.getElementById('playAgainBtn').style.display = 'inline-block';
                roundNumber = 3;
                return;
            }

            document.getElementById('playAgainBtn').style.display = 'none';
            await openPostGameSurvey('next');
        }

        // Show feedback
        function showFeedback(message, isSuccess) {
            const feedback = document.getElementById('feedbackMessage');
            feedback.textContent = message;
            feedback.className = isSuccess ? 'alert alert-success' : 'alert alert-danger';
            feedback.style.display = 'block';
            
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 1500);
        }

        // Play again
        async function playAgain() {
            await startNextRound();
        }

        function renderSection3Leaderboard() {
            const tbody = document.getElementById('section3ScoreboardBody');
            tbody.innerHTML = '';

            if (section3Leaderboard.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-muted">No records yet.</td></tr>';
                return;
            }

            section3Leaderboard.forEach(entry => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${entry.rank}</td>
                    <td>${entry.playerName}</td>
                    <td>${entry.score}</td>
                    <td>${Number(entry.totalTimeSeconds || 0).toFixed(1)}</td>
                `;
                tbody.appendChild(row);
            });
        }

        async function fetchSection3Leaderboard() {
            try {
                const response = await fetch('/api/GameData/leaderboard/section3');
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to fetch Section 3 leaderboard:', data.error);
                    return;
                }

                section3Leaderboard.length = 0;
                section3Leaderboard.push(...(data.leaderboard || []));
                renderSection3Leaderboard();
            } catch (error) {
                console.error('Error fetching Section 3 leaderboard:', error);
            }
        }

        async function openPostGameSurvey(action) {
            pendingSurveyAction = action;
            clearSurveyError();

            const surveyHr = await fetchLatestHR();
            if (surveyHr != null) {
                heartRateBefore = surveyHr;
                liveHeartRate = surveyHr;
                sessionStorage.setItem('baselineHeartRate', String(surveyHr));
                localStorage.setItem('baselineHeartRate', String(surveyHr));
                sessionStorage.setItem('section3HeartRate', String(surveyHr));
                localStorage.setItem('section3HeartRate', String(surveyHr));
                console.log('HR refreshed just before survey:', surveyHr, 'bpm');
            }

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal'));
            modal.show();
        }

        function clearSurveyError() {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.style.display = 'none';
                errorEl.textContent = '';
            }
        }

        function showSurveyError(message) {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.style.display = 'block';
            }
        }

        function getSurveyResponses() {
            const readValue = (name) => {
                const selected = document.querySelector(`input[name="${name}"]:checked`);
                return selected ? parseInt(selected.value, 10) : null;
            };

            return {
                frustrationStressAnnoyed: readValue('surveyFrustration'),
                timePressure: readValue('surveyTimePressure'),
                mentalEffort: readValue('surveyMentalEffort'),
                success: readValue('surveySuccess')
            };
        }

        document.getElementById('submitSurveyBtn').addEventListener('click', async function() {
            clearSurveyError();

            if (!currentSavedGameId) {
                showSurveyError('Please wait for the game to save before continuing.');
                return;
            }

            const surveyResponses = getSurveyResponses();
            if (Object.values(surveyResponses).some(value => value == null)) {
                showSurveyError('Please answer all four questions before continuing.');
                return;
            }

            try {
                const response = await fetch('/api/GameData/survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        gameId: currentSavedGameId,
                        surveyResponses: surveyResponses
                    })
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    showSurveyError(data.error || 'Could not save survey answers.');
                    return;
                }

                if (pendingMlPayload) {
                    await sendMLPrediction(
                        pendingMlPayload.gameData,
                        pendingMlPayload.behaviorData,
                        pendingMlPayload.headData
                    );
                    pendingMlPayload = null;
                }

                bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal')).hide();

                const playAgainBtn = document.getElementById('playAgainBtn');
                if (playAgainBtn) {
                    playAgainBtn.textContent = 'Play Again';
                    playAgainBtn.style.display = 'inline-block';
                }
            } catch (error) {
                showSurveyError(error.message || 'Could not save survey answers.');
            }
        });

       // Save game data
async function saveGameData(completed) {
    try {
        console.log('=== SAVE GAME DATA START ===');
        console.log('SessionId:', gameState.sessionId);
        
        // Check if sessionId exists
        if (!gameState.sessionId) {
            console.error('❌ ERROR: SessionId is null or empty!');
            console.error('You must start from the Home page to create a session first.');
            alert('Error: No session found. Please go back to Home and select Section 3.');
            return;
        }
        
        // Stop HR polling
        stopHRPolling();

        const fallbackHr = await fetchLatestHR();
        const finalHeartRate = liveHeartRate ?? fallbackHr ?? null;
        const initialHeartRate = heartRateBefore
            ?? getStoredNumber('section2HeartRate')
            ?? getStoredNumber('section1HeartRate')
            ?? getStoredNumber('baselineHeartRate');
        
        mouseTracker.stopTracking();
        const mouseData = mouseTracker.getData();
        if (isHeadTrackingEnabled) {
            headTracker.stopTracking();
        }
        const headData = isHeadTrackingEnabled
            ? headTracker.getData()
            : { averageHeadMovement: 0, lookAwayCount: 0, tiltCount: 0 };
        
        const behaviorData = behaviorLogger.endGame();
        
        // Fix: Ensure all dates in hesitationPauses are proper ISO strings and filter out incomplete pauses
        if (behaviorData.hesitationPauses) {
            behaviorData.hesitationPauses = behaviorData.hesitationPauses
                .filter(pause => pause.endTime != null) // Only include completed pauses
                .map(pause => ({
                    ...pause,
                    startTime: pause.startTime ? new Date(pause.startTime).toISOString() : null,
                    endTime: pause.endTime ? new Date(pause.endTime).toISOString() : null
                }));
        }
        
        const endTime = gameState.endTime || new Date().toISOString();
        const totalSeconds = (new Date(endTime) - new Date(gameState.startTime)) / 1000;
        
        // Create the game result object (NOT wrapped!)
        const gameResult = {
            sessionId: gameState.sessionId,
            gameType: gameState.gameType,
            sectionNumber: gameState.sectionNumber,
            startTime: gameState.startTime,
            endTime: endTime,
            score: gameState.arrowsStuck,
            surveyavg: 0,
            totalTimeSeconds: totalSeconds,
            completed: completed && !gameState.gameLost,
            
            behaviorData: {
                mouseMovements: mouseData.movements || [],
                typingEvents: behaviorData.typingEvents || [],
                hesitationPauses: behaviorData.hesitationPauses || [],
                averageMouseSpeed: mouseData.averageSpeed || 0,
                averageTypingSpeed: behaviorData.averageTypingSpeed || 0,
                averageHeadMovement: headData.averageHeadMovement || 0,
                lookAwayCount: headData.lookAwayCount || 0,
                headTiltCount: headData.tiltCount || 0,
                heartRate: finalHeartRate,
                heartRatebefore: initialHeartRate,
                heartRateDifference: (finalHeartRate != null && initialHeartRate != null) ? finalHeartRate - initialHeartRate : null
            },
            
            gameData: {
                score: gameState.arrowsStuck,
                bestScore: gameState.bestScore,
                arrowThrows: gameState.arrowThrows.map(t => ({
                    timestamp: t.timestamp,
                    angle: t.angle,
                    hitAnotherArrow: t.hitAnotherArrow,
                    rotationSpeed: t.rotationSpeed
                }))
            }
        };
        
        console.log('Payload being sent:', JSON.stringify(gameResult));
        console.log('Calling fetch to /api/GameData/save...');
        const response = await fetch('/api/GameData/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(gameResult)
        });
        
        console.log('Response status:', response.status);
        
        const data = await response.json();
        console.log('Response data:', data);
        
        if (data.success) {
            console.log('✅ Game data saved successfully! ID:', data.id);
                    currentSavedGameId = data.id;
            if (finalHeartRate != null) {
                sessionStorage.setItem('section3HeartRate', String(finalHeartRate));
            }
            await sendMLPrediction(
                {
                    gameId: data.id,
                    sessionId: gameResult.sessionId,
                    totalTimeSeconds: gameResult.totalTimeSeconds,
                    heartRate: gameResult.behaviorData.heartRate,
                    heartRateBefore: gameResult.behaviorData.heartRatebefore,
                    heartRateDifference: gameResult.behaviorData.heartRateDifference,
                    gameTypeEncoded: 3,
                    sectionNumber: gameResult.sectionNumber,
                    score: gameResult.score,
                    completed: gameResult.completed
                },
                {
                    mouseMovementsCount: (gameResult.behaviorData.mouseMovements || []).length,
                    averageMouseSpeed: gameResult.behaviorData.averageMouseSpeed,
                    typingEventsCount: (gameResult.behaviorData.typingEvents || []).length,
                    averageTypingSpeed: gameResult.behaviorData.averageTypingSpeed,
                    hesitationPausesCount: (gameResult.behaviorData.hesitationPauses || []).length
                },
                {
                    averageHeadMovement: gameResult.behaviorData.averageHeadMovement,
                    lookAwayCount: gameResult.behaviorData.lookAwayCount,
                    headTiltCount: gameResult.behaviorData.headTiltCount
                }
            );
            fetchSection3Leaderboard();
            if (gameState.arrowsStuck > gameState.bestScore) {
                gameState.bestScore = gameState.arrowsStuck;
                localStorage.setItem('twistyArrowBest', gameState.bestScore);
                document.getElementById('bestScore').textContent = gameState.bestScore;
            }
        } else {
            console.error('❌ Save failed:', data.error || data.title);
            if (data.errors) {
                console.error('Validation errors:', JSON.stringify(data.errors, null, 2));
            }
        }
    } catch (error) {
        console.error('❌ Error saving:', error);
        console.error('Error details:', error.message);
    }
}

        async function sendMLPrediction(gameData, behaviorData, headData) {
            const payload = {
                gameId: gameData.gameId ?? null,
                sessionId: gameData.sessionId ?? gameState.sessionId,
                mouseMovementsCount: behaviorData.mouseMovementsCount ?? 0,
                averageMouseSpeed: behaviorData.averageMouseSpeed ?? 0,
                typingEventsCount: behaviorData.typingEventsCount ?? 0,
                averageTypingSpeed: behaviorData.averageTypingSpeed ?? 0,
                hesitationPausesCount: behaviorData.hesitationPausesCount ?? 0,
                averageHeadMovement: headData.averageHeadMovement ?? 0,
                lookAwayCount: headData.lookAwayCount ?? 0,
                headTiltCount: headData.headTiltCount ?? 0,
                totalTimeSeconds: gameData.totalTimeSeconds ?? 0,
                heartRate: gameData.heartRate ?? null,
                heartRatebefore: gameData.heartRateBefore ?? null,
                heartRateDifference: gameData.heartRateDifference ?? null,
                age: sessionData.age ?? 0,
                gameType: gameData.gameTypeEncoded ?? 0,
                sectionNumber: gameData.sectionNumber ?? 1,
                score: gameData.score ?? 0,
                completed: gameData.completed ? 1 : 0
            };

            try {
                const response = await fetch('/api/GameData/ml-predict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                console.log('ML Result:', result);

                showMLResult(result);
            } catch (err) {
                console.error('ML prediction failed:', err);
            }
        }

        function showMLResult(result) {
            const box = document.getElementById('ml-result-box');
            if (box) {
                box.innerHTML = '';
                box.style.display = 'none';
            }
        }

        // Event listeners
        document.getElementById('startGameBtn').addEventListener('click', async function() {
            await startGame();
        });
        document.getElementById('playAgainBtn').addEventListener('click', playAgain);

        // Space key starts game if not started, otherwise fires an arrow. The on-screen "Press Space" button is informational only.
        document.addEventListener('keydown', async (e) => {
            if (e.code !== 'Space') return;
            e.preventDefault();
            if (!gameState.gameStarted) {
                await startGame();
                return;
            }
            if (gameState.gameLost || gameState.gameCompleted) return;
            // Fire arrow on space during active game
            shootArrow();
        });

        window.addEventListener('beforeunload', () => {
            if (animationFrame) cancelAnimationFrame(animationFrame);
        });

        console.log('Twisty Arrow Game initialized with session:', gameState.sessionId);

        // Show instructions modal on page load
        document.addEventListener('DOMContentLoaded', function() {
            const instructionsText = document.getElementById('section3InstructionsText');
            instructionsText.innerHTML = `
                <p><strong>You're now on the final challenge!</strong></p>
                <p>Shoot arrows into the spinning circle.</p>
                <p>Simple rule: don't hit an arrow that's already there!</p>

                <p>- Press Space to fire</p>
                <p>- The circle never stops spinning</p>
                <p>- One collision = Game Over</p>
               <p> You got 3 attempts </p>
                <p><em>You've got this! Let's go!</em></p>
            `;
            
            const modal = new bootstrap.Modal(document.getElementById('section3InstructionsModal'));
            
            document.getElementById('section3InstructionsStartBtn').onclick = function() {
                modal.hide();
            };
            
            modal.show();
        });
    </script>
}

