@{
    ViewData["Title"] = "Word Scramble Race";
}

<style>
    body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; }

    .game-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }

    .game-card {
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1.5rem;
        max-width: 700px;
        width: 100%;
        color: #fff;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }

    .section-badge {
        display: inline-block;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        margin-bottom: 0.5rem;
    }

    .game-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(90deg, #fff 0%, #b5c6ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .how-to-play { font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.5; }

    .stats-bar {
        background: rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .stat-item { text-align: center; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #f5a623; line-height: 1; }
    .stat-value.timer-urgent { color: #e94560; animation: pulse 0.5s infinite alternate; }
    @@keyframes pulse { from { opacity: 1; } to { opacity: 0.5; } }

    .category-pill {
        display: inline-block;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.4rem 1.2rem;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(108,99,255,0.4);
    }

    .scrambled-word {
        font-size: 3rem;
        font-weight: 900;
        letter-spacing: 10px;
        color: #fff;
        text-shadow: 0 0 30px rgba(108,99,255,0.6);
    }

    .game-input {
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: 0.75rem;
        color: #fff;
        font-size: 1.2rem;
        font-weight: 700;
        text-align: center;
        letter-spacing: 0.1em;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .game-input::placeholder { color: rgba(255,255,255,0.3); }
    .game-input:focus { background: rgba(255,255,255,0.12); border-color: #6c63ff; box-shadow: 0 0 20px rgba(108,99,255,0.3); outline: none; color: #fff; }
    .game-input:disabled { opacity: 0.5; }

    .correct-word-reveal {
        background: rgba(56,239,125,0.12);
        border: 1px solid rgba(56,239,125,0.3);
        border-radius: 0.75rem;
        color: rgba(255,255,255,0.9);
        font-size: 0.95rem;
    }

    .btn-game-primary {
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(108,99,255,0.4);
    }
    .btn-game-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(108,99,255,0.6); color: #fff; }
    .btn-game-primary:disabled { opacity: 0.4; transform: none; }

    .btn-game-success {
        background: linear-gradient(90deg, #11998e, #38ef7d);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(56,239,125,0.35);
    }
    .btn-game-success:hover { transform: translateY(-2px); color: #fff; }
    .btn-game-success:disabled { opacity: 0.4; transform: none; }

    .btn-game-secondary {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.8); font-weight: 600;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-game-secondary:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .btn-game-next {
        background: linear-gradient(90deg, #f5a623, #f04e23);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(245,166,35,0.4);
    }
    .btn-game-next:hover { transform: translateY(-2px); color: #fff; }

    .btn-scoreboard {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.75);
        font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em;
        padding: 0.3rem 0.9rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-scoreboard:hover { background: rgba(255,255,255,0.18); color: #fff; }

    #feedbackMessage {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        min-width: 280px;
        text-align: center;
        border-radius: 50px;
        font-weight: 700;
        padding: 0.6rem 1.5rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
</style>

<div class="game-wrapper">
    <div class="game-card p-4 p-md-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="section-badge">Section 2</span>
                <h1 class="game-title">Word Scramble Race</h1>
                <p class="how-to-play">Unscramble the letters to find the correct word. 15 seconds per word!</p>
            </div>
            <button id="openScoreboardBtn" type="button" class="btn btn-scoreboard ms-3 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#section2ScoreboardModal">
                🏆 Scoreboard
            </button>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar mb-4">
            <div class="stat-item">
                <div class="stat-label">Score</div>
                <div class="stat-value"><span id="score">0</span></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Word</div>
                <div class="stat-value"><span id="wordCount">1</span></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Time Left</div>
                <div class="stat-value" id="timerValue"><span id="timer">15.0</span>s</div>
            </div>
        </div>

        <!-- Category Badge -->
        <div class="text-center mb-4">
            <span class="category-pill">📂 <span id="categoryName">-</span></span>
        </div>

        <!-- Feedback -->
        <div id="feedbackMessage" class="alert" style="display:none;"></div>

        <!-- Game Area -->
        <div class="text-center">
            <div class="mb-4">
                <div id="scrambledWord" class="scrambled-word">LOADING</div>
            </div>

            <div class="mb-3" style="max-width:400px;margin:0 auto;">
                <input type="text" id="userInput" class="form-control game-input"
                       placeholder="Type your answer..." autocomplete="off" disabled>
            </div>

            <div id="answerFeedback" class="mb-3" style="min-height:28px;font-weight:700;"></div>

            <div id="correctWordDisplay" class="correct-word-reveal px-3 py-2 mb-3 mx-auto" style="display:none;max-width:400px;">
                ✅ The word was: <strong id="correctWord"></strong>
            </div>

            <div class="d-flex justify-content-center gap-3 flex-wrap mt-2">
                <button id="submitBtn" class="btn btn-game-success btn-lg" disabled>Submit ↵</button>
                <button id="nextBtn" class="btn btn-game-primary btn-lg" style="display:none;">Next Word →</button>
                <button id="playAgainBtn" class="btn btn-game-secondary btn-lg" style="display:none;">↩ Play Again</button>
                <button id="nextGameBtn" class="btn btn-game-next btn-lg" style="display:none;">Next Game →</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="section2ScoreboardModal" tabindex="-1" aria-labelledby="section2ScoreboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#1a1a2e;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(90deg,#6c63ff,#48c6ef);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-800" id="section2ScoreboardModalLabel">🏆 Section 2 — Top Players</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.5);">Ranked by highest score</span>
                    <button id="clearSection2LeaderboardBtn" class="btn btn-sm" style="background:rgba(233,69,96,0.2);border:1px solid rgba(233,69,96,0.5);color:#e94560;border-radius:50px;">🗑 Clear</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="color:#fff;">
                        <thead style="border-bottom:1px solid rgba(255,255,255,0.1);">
                            <tr style="color:rgba(255,255,255,0.5);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em;">
                                <th class="fw-normal pb-2">Rank</th>
                                <th class="fw-normal pb-2">Player</th>
                                <th class="fw-normal pb-2">Score</th>
                                <th class="fw-normal pb-2">Correct Words</th>
                            </tr>
                        </thead>
                        <tbody id="section2ScoreboardBody">
                            <tr><td colspan="4" style="color:rgba(255,255,255,0.4);padding:1.5rem 0;text-align:center;">No records yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/behaviorLogger.js"></script>
    <script src="~/js/mouseSpeed.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@@3.21.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/blazeface@@0.0.7/dist/blazeface.min.js"></script>
    <script src="~/js/headTracker.js"></script>
    <script>
        // Word database grouped by category (one word from each category per round)
        const wordCategories = {
            animals: ["CAT", "DOG", "LION", "BEAR", "DUCK", "FISH", "WOLF", "FROG", "DEER", "GOAT", "HORSE", "SNAKE", "MONKEY", "PANDA", "ZEBRA"],
            fruits: ["APPLE", "PEAR", "GRAPE", "MANGO", "PEACH", "LEMON", "MELON", "BERRY", "ORANGE", "BANANA", "KIWI","STRAWBERRY", "WATERMELON", "PINEAPPLE", "BLUEBERRY"],
            countries: ["EGYPT", "FRANCE", "SPAIN", "CHINA", "INDIA", "JAPAN", "BRAZIL", "ITALY", "CANADA", "MEXICO", "RUSSIA", "AUSTRALIA", "GERMANY", "GREECE", "PORTUGAL"],
            colours: ["RED", "BLUE", "GREEN", "BLACK", "WHITE", "BROWN", "PINK", "GRAY", "GOLD", "SILVER", "PURPLE", "ORANGE", "YELLOW"],
            food: ["BREAD", "RICE", "PASTA", "SOUP", "CAKE", "PIZZA", "SALAD", "CHEESE", "MILK", "EGG", "MEAT", "FISH","SANDWICH", "STEAK", "TOAST"]
        };

        function pickRandomWord(list) {
            return list[Math.floor(Math.random() * list.length)];
        }
        
        // Function to randomize letters
        function randomizeLetters(word) {
            if (!word || word.length < 2) return word;

            const letters = word.split('');
            let shuffled = word;
            let attempts = 0;

            while (shuffled === word && attempts < 8) {
                for (let i = letters.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [letters[i], letters[j]] = [letters[j], letters[i]];
                }
                shuffled = letters.join('');
                attempts++;
            }

            return shuffled;
        }

        // Game state
        let gameState = {
            sessionId: sessionStorage.getItem('sessionId'),
            gameType: 'Word Scramble Race',
            sectionNumber: 2,
            startTime: null,
            endTime: null,
            score: 0,
            currentWordIndex: 0,
            totalWords: 5,
            gameWords: [],
            wordStartTime: null,
            wordEndTime: null,
            typingEvents: [],
            gameStarted: false,
            gameCompleted: false,
            currentWordData: null,
            wordsCompleted: []
        };

        // Initialize tracking
        const behaviorLogger = new BehaviorLogger(gameState.sessionId, gameState.sectionNumber);
        const mouseTracker = new MouseSpeedTracker();
        const headTracker = new HeadTracker();
        const section2Leaderboard = [];

        // Timer variables
        let timerInterval;
        let timeLeft = 15;

        // Verify session
        if (!gameState.sessionId) {
            alert('No session found. Please start from the homepage.');
            window.location.href = '/';
        }

        document.getElementById('openScoreboardBtn').addEventListener('click', fetchSection2Leaderboard);

        document.getElementById('clearSection2LeaderboardBtn').addEventListener('click', async function() {
            if (!confirm('Clear all leaderboard entries?')) return;
            await fetch('/api/GameData/leaderboard/section2', { method: 'DELETE' });
            fetchSection2Leaderboard();
        });

        // Start game
        document.addEventListener('DOMContentLoaded', function() {
            startNewGame();
        });

        function startNewGame() {
            // Select 1 random word from each category, then shuffle order.
            gameState.gameWords = [
                { category: "Animals", original: pickRandomWord(wordCategories.animals) },
                { category: "Fruits", original: pickRandomWord(wordCategories.fruits) },
                { category: "Countries", original: pickRandomWord(wordCategories.countries) },
                { category: "Colours", original: pickRandomWord(wordCategories.colours) },
                { category: "Food", original: pickRandomWord(wordCategories.food) }
            ].sort(() => Math.random() - 0.5);
            gameState.currentWordIndex = 0;
            gameState.score = 0;
            gameState.wordsCompleted = [];
            gameState.startTime = new Date().toISOString();
            gameState.gameStarted = true;
            
            document.getElementById('score').textContent = gameState.score;
            document.getElementById('wordCount').textContent = '1/' + gameState.totalWords;
            
            // Start tracking
            mouseTracker.startTracking();
            behaviorLogger.startGame(gameState.gameType);
            headTracker.startTracking();
            
            loadWord();
        }

        function loadWord() {
            gameState.currentWordData = gameState.gameWords[gameState.currentWordIndex];
            gameState.wordStartTime = new Date().toISOString();
            document.getElementById('categoryName').textContent = gameState.currentWordData.category;
            
            // Generate random scrambled version
            const scrambled = randomizeLetters(gameState.currentWordData.original);
            document.getElementById('scrambledWord').textContent = scrambled;
            document.getElementById('userInput').value = '';
            document.getElementById('userInput').disabled = false;
            document.getElementById('userInput').focus();
            document.getElementById('answerFeedback').innerHTML = '';
            document.getElementById('correctWordDisplay').style.display = 'none';
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('submitBtn').style.display = 'inline-block';
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('playAgainBtn').style.display = 'none';
            document.getElementById('nextGameBtn').style.display = 'none';
            
            // Reset timer
            timeLeft = 15;
            updateTimerDisplay();
            
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timeLeft -= 0.1;
                updateTimerDisplay();
                
                if (timeLeft <= 0) {
                    timeLeft = 0;
                    updateTimerDisplay();
                    handleTimeout();
                }
            }, 100);
        }

        function updateTimerDisplay() {
            document.getElementById('timer').textContent = timeLeft.toFixed(1);
        }

        function handleTimeout() {
            clearInterval(timerInterval);
            document.getElementById('userInput').disabled = true;
            document.getElementById('submitBtn').disabled = true;
            
            // Show correct word
            document.getElementById('correctWord').textContent = gameState.currentWordData.original;
            document.getElementById('correctWordDisplay').style.display = 'block';
            
            // Record wrong answer
            recordWordResult(false, 15);
            
            document.getElementById('answerFeedback').innerHTML = '<span class="text-danger fw-bold">⏰ TIME\'S UP!</span>';
            
            // Show appropriate button
            if (gameState.currentWordIndex >= gameState.totalWords - 1) {
                document.getElementById('nextGameBtn').style.display = 'inline-block';
            } else {
                document.getElementById('nextBtn').style.display = 'inline-block';
            }
        }

        function checkAnswer() {
            const userInput = document.getElementById('userInput').value.toUpperCase().trim();
            const isCorrect = (userInput === gameState.currentWordData.original);
            const timeTaken = 15 - timeLeft;
            
            clearInterval(timerInterval);
            document.getElementById('userInput').disabled = true;
            document.getElementById('submitBtn').disabled = true;
            
            // Show correct word
            document.getElementById('correctWord').textContent = gameState.currentWordData.original;
            document.getElementById('correctWordDisplay').style.display = 'block';
            
            if (isCorrect) {
                const wordScore = 50;
                gameState.score += wordScore;
                document.getElementById('score').textContent = gameState.score;
                
                document.getElementById('answerFeedback').innerHTML = '<span class="text-success fw-bold">✅ CORRECT! +' + wordScore + ' points</span>';
            } else {
                document.getElementById('answerFeedback').innerHTML = '<span class="text-danger fw-bold">❌ INCORRECT!</span>';
            }
            
            // Record result
            recordWordResult(isCorrect, timeTaken);
            
            // Show appropriate button
            if (gameState.currentWordIndex >= gameState.totalWords - 1) {
                document.getElementById('nextGameBtn').style.display = 'inline-block';
            } else {
                document.getElementById('nextBtn').style.display = 'inline-block';
            }
        }

        function recordWordResult(isCorrect, timeTaken) {
            const wpm = timeTaken > 0 ? 
                (gameState.currentWordData.original.length / 5) / (timeTaken / 60) : 0;
            
            gameState.wordsCompleted.push({
                category: gameState.currentWordData.category,
                word: gameState.currentWordData.original,
                scrambled: randomizeLetters(gameState.currentWordData.original),
                userAnswer: document.getElementById('userInput').value.toUpperCase().trim(),
                isCorrect: isCorrect,
                timeTaken: timeTaken,
                wpm: wpm,
                startTime: gameState.wordStartTime,
                endTime: new Date().toISOString()
            });
        }

        function nextWord() {
            gameState.currentWordIndex++;
            document.getElementById('wordCount').textContent = (gameState.currentWordIndex + 1) + '/' + gameState.totalWords;
            loadWord();
        }

        function playAgain() {
            // Save current game data first
            saveGameData(false).then(() => {
                startNewGame();
            });
        }

        function goToNextGame() {
            // Save final game data
            saveGameData(true).then(() => {
                window.location.href = '/Questions/Section3';
            });
        }

        function renderSection2Leaderboard() {
            const tbody = document.getElementById('section2ScoreboardBody');
            tbody.innerHTML = '';

            if (section2Leaderboard.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-muted">No records yet.</td></tr>';
                return;
            }

            section2Leaderboard.forEach(entry => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${entry.rank}</td>
                    <td>${entry.playerName}</td>
                    <td>${entry.score}</td>
                    <td>${entry.correctCount}</td>
                `;
                tbody.appendChild(row);
            });
        }

        async function fetchSection2Leaderboard() {
            try {
                const response = await fetch('/api/GameData/leaderboard/section2');
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to fetch Section 2 leaderboard:', data.error);
                    return;
                }

                section2Leaderboard.length = 0;
                section2Leaderboard.push(...(data.leaderboard || []));
                renderSection2Leaderboard();
            } catch (error) {
                console.error('Error fetching Section 2 leaderboard:', error);
            }
        }

        async function saveGameData(completed) {
            // Stop tracking
            mouseTracker.stopTracking();
            headTracker.stopTracking();
            const mouseData = mouseTracker.getData();
            const headData = headTracker.getData();
            
            // Collect behavior data
            const behaviorData = behaviorLogger.endGame();
            
            // Fix: Ensure all dates in hesitationPauses are proper ISO strings and filter out incomplete pauses
            if (behaviorData.hesitationPauses) {
                behaviorData.hesitationPauses = behaviorData.hesitationPauses
                    .filter(pause => pause.endTime != null) // Only include completed pauses
                    .map(pause => ({
                        ...pause,
                        startTime: pause.startTime ? new Date(pause.startTime).toISOString() : null,
                        endTime: pause.endTime ? new Date(pause.endTime).toISOString() : null
                    }));
            }
            
            // Calculate averages
            const avgWPM = gameState.wordsCompleted.reduce((sum, w) => sum + w.wpm, 0) / gameState.wordsCompleted.length;
            const correctCount = gameState.wordsCompleted.filter(w => w.isCorrect).length;
            
            // Prepare game result
            const gameResult = {
                sessionId: gameState.sessionId,
                gameType: "Word Scramble Race",
                sectionNumber: 2,
                startTime: gameState.startTime,
                endTime: new Date().toISOString(),
                score: gameState.score,
                totalTimeSeconds: (new Date() - new Date(gameState.startTime)) / 1000,
                completed: completed,
                
                behaviorData: {
                    mouseMovements: mouseData.movements || [],
                    typingEvents: behaviorData.typingEvents || [],
                    headPositions: [],
                    hesitationPauses: behaviorData.hesitationPauses || [],
                    averageMouseSpeed: mouseData.averageSpeed || 0,
                    averageTypingSpeed: behaviorData.averageTypingSpeed || 0,
                    averageHeadMovement: headData.averageHeadMovement || 0,
                    lookAwayCount: headData.lookAwayCount || 0,
                    headTiltCount: headData.tiltCount || 0,
                    heartRate: 0
                },
                
                gameData: {
                    wordsCompleted: gameState.wordsCompleted,
                    correctCount: correctCount,
                    totalWords: gameState.totalWords,
                    averageWPM: avgWPM,
                    accuracy: (correctCount / gameState.totalWords) * 100
                }
            };
            
            console.log("Saving game data:", gameResult);
            
            try {
                const response = await fetch('/api/GameData/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(gameResult)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    console.log("Game data saved!");
                    showGlobalFeedback('Game saved!', true);
                    fetchSection2Leaderboard();
                } else {
                    console.error("Save failed:", data.error);
                }
            } catch (error) {
                console.error("Error saving:", error);
            }
        }

        function showGlobalFeedback(message, isSuccess) {
            const feedback = document.getElementById('feedbackMessage');
            feedback.textContent = message;
            feedback.className = isSuccess ? 'alert alert-success' : 'alert alert-danger';
            feedback.style.display = 'block';
            
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }

        // Event listeners
        document.getElementById('submitBtn').addEventListener('click', checkAnswer);
        document.getElementById('nextBtn').addEventListener('click', nextWord);
        document.getElementById('playAgainBtn').addEventListener('click', playAgain);
        document.getElementById('nextGameBtn').addEventListener('click', goToNextGame);
        
        // Enter key to submit
        document.getElementById('userInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !document.getElementById('submitBtn').disabled) {
                checkAnswer();
            }
        });

        console.log("Word Scramble game initialized with session:", gameState.sessionId);
    </script>
}

