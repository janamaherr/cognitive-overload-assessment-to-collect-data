@{
    ViewData["Title"] = "Sentence Memory Test";
}

<style>
    body { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); min-height: 100vh; }

    .game-wrapper { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; }

    .game-card {
        background: rgba(18, 27, 45, 0.92);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 1.5rem;
        max-width: 700px;
        width: 100%;
        color: #fff;
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    }

    .section-badge {
        display: inline-block;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        margin-bottom: 0.5rem;
    }

    .game-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(90deg, #fff 0%, #b5c6ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .how-to-play { font-size: 0.85rem; color: rgba(255,255,255,0.55); line-height: 1.5; }

    .stats-bar {
        background: rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .stat-item { text-align: center; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.5); }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #f5a623; line-height: 1; }
    .stat-value.timer-urgent { color: #e94560; animation: pulse 0.5s infinite alternate; }
    @@keyframes pulse { from { opacity: 1; } to { opacity: 0.5; } }

    .category-pill {
        display: inline-block;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.4rem 1.2rem;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(108,99,255,0.4);
    }

    .sentence-display {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
        text-shadow: 0 0 20px rgba(108,99,255,0.4);
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1.6;
    }

    .sentence-hidden {
        color: rgba(255,255,255,0.2);
        font-size: 1rem;
    }

    .difficulty-indicator {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.6);
        font-weight: 600;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .timers-strip {
        display: flex;
        justify-content: center;
        gap: 0.8rem;
        flex-wrap: wrap;
        margin: 0 0 1rem;
    }

    .timer-chip {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.85);
        min-width: 200px;
        text-align: center;
    }

    .timer-chip strong {
        color: #f5a623;
        font-weight: 800;
    }

    .game-input {
        background: rgba(255,255,255,0.08);
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: 0.75rem;
        color: #fff;
        font-size: 1.1rem;
        font-weight: 500;
        text-align: left;
        line-height: 1.6;
        padding: 0.8rem 1rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        min-height: 80px;
        resize: none;
    }
    .game-input::placeholder { color: rgba(255,255,255,0.3); }
    .game-input:focus { background: rgba(255,255,255,0.12); border-color: #6c63ff; box-shadow: 0 0 20px rgba(108,99,255,0.3); outline: none; color: #fff; }
    .game-input:disabled { opacity: 0.5; }

    .correct-word-reveal {
        background: rgba(56,239,125,0.12);
        border: 1px solid rgba(56,239,125,0.3);
        border-radius: 0.75rem;
        color: rgba(255,255,255,0.9);
        font-size: 0.95rem;
        padding: 0.8rem 1rem;
    }

    .btn-game-primary {
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(108,99,255,0.4);
    }
    .btn-game-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(108,99,255,0.6); color: #fff; }
    .btn-game-primary:disabled { opacity: 0.4; transform: none; }

    .btn-game-success {
        background: linear-gradient(90deg, #11998e, #38ef7d);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(56,239,125,0.35);
    }
    .btn-game-success:hover { transform: translateY(-2px); color: #fff; }
    .btn-game-success:disabled { opacity: 0.4; transform: none; }

    .btn-game-secondary {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        color: rgba(255,255,255,0.8); font-weight: 600;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-game-secondary:hover { background: rgba(255,255,255,0.2); color: #fff; }

    .btn-game-next {
        background: linear-gradient(90deg, #f5a623, #f04e23);
        border: none; color: #fff; font-weight: 700;
        padding: 0.6rem 1.8rem; border-radius: 50px;
        transition: transform 0.15s, box-shadow 0.15s;
        box-shadow: 0 4px 15px rgba(245,166,35,0.4);
    }
    .btn-game-next:hover { transform: translateY(-2px); color: #fff; }

    .btn-scoreboard {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        color: rgba(255,255,255,0.75);
        font-size: 0.8rem; font-weight: 600; letter-spacing: 0.05em;
        padding: 0.3rem 0.9rem; border-radius: 50px;
        transition: all 0.15s;
    }
    .btn-scoreboard:hover { background: rgba(255,255,255,0.18); color: #fff; }

    .survey-step {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .survey-scale-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.55);
        margin-bottom: 0.35rem;
    }

    .survey-pill {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.85);
        border-radius: 999px;
        min-width: 42px;
        padding: 0.35rem 0.75rem;
        font-weight: 700;
        transition: all 0.15s ease;
    }

    .btn-check:checked + .survey-pill {
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 14px rgba(108,99,255,0.35);
    }

    #feedbackMessage {
        position: fixed;
        top: 24px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        min-width: 280px;
        text-align: center;
        border-radius: 50px;
        font-weight: 700;
        padding: 0.6rem 1.5rem;
        box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
</style>

<div class="game-wrapper">
    <div class="game-card p-4 p-md-5">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="section-badge">Section 2</span>
                <h1 class="game-title">Sentence Memory Test</h1>
                <p class="how-to-play">A sentence appears briefly, then disappears. Type it from memory. Sentences get longer!</p>
            </div>
            <button id="openScoreboardBtn" type="button" class="btn btn-scoreboard ms-3 flex-shrink-0" data-bs-toggle="modal" data-bs-target="#section2ScoreboardModal">
                🏆 Scoreboard
            </button>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar mb-4">
            <div class="stat-item">
                <div class="stat-label">Score</div>
                <div class="stat-value"><span id="score">0</span></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Sentence</div>
                <div class="stat-value"><span id="sentenceCount">1</span>/<span id="totalSentences">5</span></div>
            </div>
            <div class="stat-item">
                <div class="stat-label">Difficulty</div>
                <div class="stat-value"><span id="wordCount">5</span>w</div>
            </div>
        </div>

        <!-- Difficulty Indicator -->
        <div class="text-center mb-3">
            <span class="difficulty-indicator" id="difficultyLabel">Easy — 5 words</span>
        </div>

        <div class="timers-strip">
            <div class="timer-chip">Disappears in: <strong id="revealCountdown">--</strong></div>
            <div class="timer-chip">Typing time: <strong id="typingStopwatch">0.00s</strong></div>
        </div>

        <!-- Feedback -->
        <div id="feedbackMessage" class="alert" style="display:none;"></div>

        <!-- Game Area -->
        <div class="text-center">
            <!-- Sentence Display -->
            <div class="mb-4 p-3" style="background:rgba(108,99,255,0.1);border-radius:0.75rem;border:1px solid rgba(108,99,255,0.3);">
                <div id="sentenceDisplay" class="sentence-display">
                    Waiting to start...
                </div>
            </div>

            <!-- Answer Input -->
            <div class="mb-3" style="max-width:500px;margin:0 auto;">
                <textarea id="userInput" class="form-control game-input"
                       placeholder="Type the sentence from memory..." autocomplete="off" disabled></textarea>
            </div>

            <div id="answerFeedback" class="mb-3" style="min-height:28px;font-weight:700;"></div>

            <!-- Correct Answer Display -->
            <div id="correctSentenceDisplay" class="correct-word-reveal px-3 py-2 mb-3 mx-auto" style="display:none;max-width:500px;">
                ✅ The sentence was: <strong id="correctSentence"></strong>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap mt-3 mb-3">
                <button id="readyBtn" class="btn btn-game-primary btn-lg">Ready →</button>
                <button id="submitBtn" class="btn btn-game-success btn-lg" style="display:none;" disabled>Submit ↵</button>
                <button id="nextBtn" class="btn btn-game-primary btn-lg" style="display:none;">Next Sentence →</button>
                <button id="playAgainBtn" class="btn btn-game-secondary btn-lg" style="display:none;">↩ Play Again</button>
                <button id="nextGameBtn" class="btn btn-game-next btn-lg" style="display:none;">Next Game →</button>
            </div>

            <div id="ml-result-box" style="display:none"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="postGameSurveyModal" tabindex="-1" aria-labelledby="postGameSurveyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#161b2f;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0" style="background:linear-gradient(90deg,#6c63ff,#48c6ef);border-radius:1.25rem 1.25rem 0 0;">
                <div>
                    <h5 class="modal-title fw-800" id="postGameSurveyModalLabel">🎮 Quick Game Reflection</h5>
                    <div style="font-size:0.82rem;opacity:0.85;">Answer a few quick questions before moving on.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <div class="survey-step">
                    <div class="fw-bold mb-2">How frustrated, stressed, or annoyed did you feel?</div>
                    <div class="survey-scale-label"><span>Not at all</span><span>Extremely</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s2-q1-1" value="1"><label class="btn survey-pill" for="s2-q1-1">1</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s2-q1-2" value="2"><label class="btn survey-pill" for="s2-q1-2">2</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s2-q1-3" value="3"><label class="btn survey-pill" for="s2-q1-3">3</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s2-q1-4" value="4"><label class="btn survey-pill" for="s2-q1-4">4</label>
                        <input class="btn-check" type="radio" name="surveyFrustration" id="s2-q1-5" value="5"><label class="btn survey-pill" for="s2-q1-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much time pressure did you feel during this game?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s2-q2-1" value="1"><label class="btn survey-pill" for="s2-q2-1">1</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s2-q2-2" value="2"><label class="btn survey-pill" for="s2-q2-2">2</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s2-q2-3" value="3"><label class="btn survey-pill" for="s2-q2-3">3</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s2-q2-4" value="4"><label class="btn survey-pill" for="s2-q2-4">4</label>
                        <input class="btn-check" type="radio" name="surveyTimePressure" id="s2-q2-5" value="5"><label class="btn survey-pill" for="s2-q2-5">5</label>
                    </div>
                </div>
                <div class="survey-step">
                    <div class="fw-bold mb-2">How much mental effort did this game require?</div>
                    <div class="survey-scale-label"><span>Very low</span><span>Very high</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s2-q3-1" value="1"><label class="btn survey-pill" for="s2-q3-1">1</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s2-q3-2" value="2"><label class="btn survey-pill" for="s2-q3-2">2</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s2-q3-3" value="3"><label class="btn survey-pill" for="s2-q3-3">3</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s2-q3-4" value="4"><label class="btn survey-pill" for="s2-q3-4">4</label>
                        <input class="btn-check" type="radio" name="surveyMentalEffort" id="s2-q3-5" value="5"><label class="btn survey-pill" for="s2-q3-5">5</label>
                    </div>
                </div>
                <div class="survey-step mb-0">
                    <div class="fw-bold mb-2">How successful do you think you were in completing the game?</div>
                    <div class="survey-scale-label"><span>Not successful</span><span>Very successful</span></div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <input class="btn-check" type="radio" name="surveySuccess" id="s2-q4-1" value="1"><label class="btn survey-pill" for="s2-q4-1">1</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s2-q4-2" value="2"><label class="btn survey-pill" for="s2-q4-2">2</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s2-q4-3" value="3"><label class="btn survey-pill" for="s2-q4-3">3</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s2-q4-4" value="4"><label class="btn survey-pill" for="s2-q4-4">4</label>
                        <input class="btn-check" type="radio" name="surveySuccess" id="s2-q4-5" value="5"><label class="btn survey-pill" for="s2-q4-5">5</label>
                    </div>
                </div>
                <div id="surveyError" class="text-danger fw-bold mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-between">
                <button type="button" class="btn btn-game-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="submitSurveyBtn" class="btn btn-game-primary">Save & Continue</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="section2ScoreboardModal" tabindex="-1" aria-labelledby="section2ScoreboardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="background:#1a1a2e;color:#fff;border:1px solid rgba(255,255,255,0.12);border-radius:1.25rem;">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(90deg,#6c63ff,#48c6ef);border-radius:1.25rem 1.25rem 0 0;">
                <h5 class="modal-title fw-800" id="section2ScoreboardModalLabel">🏆 Section 2 — Top Players</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-size:0.82rem;color:rgba(255,255,255,0.5);">Ranked by highest score</span>
                    <button id="clearSection2LeaderboardBtn" class="btn btn-sm" style="background:rgba(233,69,96,0.2);border:1px solid rgba(233,69,96,0.5);color:#e94560;border-radius:50px;">🗑 Clear</button>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" style="color:#fff;">
                        <thead style="border-bottom:1px solid rgba(255,255,255,0.1);">
                            <tr style="color:rgba(255,255,255,0.5);font-size:0.78rem;text-transform:uppercase;letter-spacing:0.08em;">
                                <th class="fw-normal pb-2">Rank</th>
                                <th class="fw-normal pb-2">Player</th>
                                <th class="fw-normal pb-2">Score</th>
                                <th class="fw-normal pb-2">Correct Sentences</th>
                            </tr>
                        </thead>
                        <tbody id="section2ScoreboardBody">
                            <tr><td colspan="4" style="color:rgba(255,255,255,0.4);padding:1.5rem 0;text-align:center;">No records yet.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/behaviorLogger.js"></script>
    <script src="~/js/mouseSpeed.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs@@3.21.0/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/blazeface@@0.0.7/dist/blazeface.min.js"></script>
    <script src="~/js/headTracker.js"></script>
    <script>
        // Sentence database by word count (to test cognitive load progression)
        const sentencesByWordCount = {
    5: [
        "the cat sat on the mat",
        "i like to drink cold water",
        "the sun is very bright",
        "birds fly high in the sky",
        "she reads books every morning",
        "the baby is sleeping now",
        "kids play games after school",
        "the flowers bloom in spring",
        "he loves to eat pizza"
    ],

    6: [
        "the quick brown fox jumps over",
        "i want to learn how to code",
        "the store closed at nine tonight",
        "my friend likes to play guitar",
        "she walks to the park every day",
        "the dog barked loudly at night",
        "she quickly finished her homework today",
        "they walked together in the park",
        "he always forgets his house keys",
        "we watched a movie last night"
    ],

    7: [
        "the weather is very nice this week",
        "i enjoy spending time with my friends",
        "the restaurant serves good food every night",
        "he decided to learn a new language",
        "the meeting was planned for tomorrow morning",
        "the teacher explained the lesson very clearly",
        "she was typing very fast during the test",
        "he forgot to save his important file",
        "we are planning a trip for next week"
    ],

    8: [
        "she wanted to visit the museum before it closed",
        "the conference started on monday morning at nine",
        "i need to buy milk and bread from store",
        "they spent the afternoon playing games together outside",
        "the movie was very fun and easy to watch",
        "the student struggled to remember the long sentence",
        "he was surprised by how hard the test was"
    ],

    9: [
        "the project took longer than expected to finish on time",
        "she decided to take a short break and relax",
        "the new restaurant in town serves very tasty pasta",
        "the team worked together to solve the hard problem",
        "the cat is sleeping on the soft bed now",  
        "i like to drink cold water every single day",
        "we went to the park to play outside today",
        "she is reading a book in her room quietly"
    ]
};

        // Sentence progression: start with 5 words, increase to 9
        const sentenceProgression = [5, 6, 7, 8, 9];
        
        function getRandomSentence(wordCount) {
            const sentences = sentencesByWordCount[wordCount];
            return sentences[Math.floor(Math.random() * sentences.length)];
        }

        // Game state
        let gameState = {
            sessionId: sessionStorage.getItem('sessionId'),
            gameType: 'Sentence Memory Test',
            sectionNumber: 2,
            startTime: null,
            endTime: null,
            score: 0,
            currentSentenceIndex: 0,
            totalSentences: 5,
            sentencesData: [],
            sentenceStartTime: null,
            sentenceShownTime: null,
            sentenceRevealBaseTime: 3,
            sentenceRevealTime: 3,
            gameStarted: false,
            gameCompleted: false,
            currentSentence: null,
            sentencesCompleted: [],
            sentenceCurrentlyVisible: false
        };
        const sessionData = {
            age: Number(sessionStorage.getItem('age') || 0)
        };

        // Initialize tracking
        const behaviorLogger = new BehaviorLogger(gameState.sessionId, gameState.sectionNumber);
        const mouseTracker = new MouseSpeedTracker();
        const headTracker = new HeadTracker();
        let headTrackingReady = false;
        const section2Leaderboard = [];

        // Timer variables for sentence reveal and typing stopwatch
        let revealTimer;
        let revealCountdownTimer;
        let typingStopwatchTimer;
        let typingStartMs = null;
        let firstKeyTimeMs = null;
        let currentSavedGameId = null;
        let pendingSurveyAction = null;

        // Verify session
        if (!gameState.sessionId) {
            alert('No session found. Please start from the homepage.');
            window.location.href = '/';
        }

        document.getElementById('openScoreboardBtn').addEventListener('click', fetchSection2Leaderboard);

        document.getElementById('clearSection2LeaderboardBtn').addEventListener('click', async function() {
            if (!confirm('Clear all leaderboard entries?')) return;
            await fetch('/api/GameData/leaderboard/section2', { method: 'DELETE' });
            fetchSection2Leaderboard();
        });

        // Start game
        document.addEventListener('DOMContentLoaded', async function() {
            await initializeGame();
        });

        async function initializeGame() {
            // Prepare sentences: one from each word count (5-9)
            gameState.sentencesData = sentenceProgression.map((wordCount, index) => ({
                wordCount: wordCount,
                original: getRandomSentence(wordCount),
                index: index
            }));
            
            gameState.currentSentenceIndex = 0;
            gameState.score = 0;
            gameState.sentencesCompleted = [];
            gameState.startTime = new Date().toISOString();
            gameState.gameStarted = true;
            currentSavedGameId = null;
            pendingSurveyAction = null;
            
            document.getElementById('score').textContent = gameState.score;
            document.getElementById('totalSentences').textContent = gameState.totalSentences;
            
            // Start tracking
            mouseTracker.startTracking();
            behaviorLogger.startGame(gameState.gameType);
            headTrackingReady = await headTracker.startTracking();
            
            showReadyButton();
        }

        function showReadyButton() {
            document.getElementById('readyBtn').style.display = 'inline-block';
            document.getElementById('readyBtn').disabled = false;
            document.getElementById('submitBtn').style.display = 'none';
            document.getElementById('nextBtn').style.display = 'none';
            document.getElementById('sentenceDisplay').textContent = 'Click "Ready" to see the next sentence';
            document.getElementById('sentenceDisplay').style.color = 'rgba(255,255,255,0.5)';
            document.getElementById('revealCountdown').textContent = '--';
            resetTypingStopwatch();
        }

        function getRevealDurationForWordCount(wordCount) {
            // 5 words => 3s, each extra word adds 1s up to 9 words.
            const extraSeconds = Math.max(0, wordCount - 5);
            return gameState.sentenceRevealBaseTime + extraSeconds;
        }

        function clearRevealCountdownTimer() {
            if (revealCountdownTimer) {
                clearInterval(revealCountdownTimer);
                revealCountdownTimer = null;
            }
        }

        function startRevealCountdown(durationSeconds) {
            clearRevealCountdownTimer();
            const countdownEl = document.getElementById('revealCountdown');
            const endsAt = Date.now() + (durationSeconds * 1000);
            let lastShown = -1;

            const tick = () => {
                const remainingMs = Math.max(0, endsAt - Date.now());
                const remainingSeconds = Math.ceil(remainingMs / 1000);

                if (remainingSeconds !== lastShown) {
                    countdownEl.textContent = remainingSeconds > 0 ? `${remainingSeconds}` : '0';
                    lastShown = remainingSeconds;
                }

                if (remainingMs <= 0) {
                    clearRevealCountdownTimer();
                }
            };

            tick();
            revealCountdownTimer = setInterval(tick, 50);
        }

        function clearTypingStopwatchTimer() {
            if (typingStopwatchTimer) {
                clearInterval(typingStopwatchTimer);
                typingStopwatchTimer = null;
            }
        }

        function resetTypingStopwatch() {
            clearTypingStopwatchTimer();
            typingStartMs = null;
            firstKeyTimeMs = null;
            document.getElementById('typingStopwatch').textContent = '0.00s';
        }

        function startTypingStopwatch() {
            resetTypingStopwatch();
            typingStartMs = Date.now();

            const update = () => {
                const elapsedMs = Date.now() - typingStartMs;
                document.getElementById('typingStopwatch').textContent = `${(elapsedMs / 1000).toFixed(2)}s`;
            };

            update();
            typingStopwatchTimer = setInterval(update, 50);
        }

        async function startSentence() {
            if (!headTrackingReady) {
                headTrackingReady = await headTracker.startTracking();
            }

            gameState.currentSentence = gameState.sentencesData[gameState.currentSentenceIndex];
            gameState.sentenceStartTime = new Date().toISOString();
            gameState.sentenceCurrentlyVisible = false;
            
            // Update difficulty display
            const diffLabel = ['Easy', 'Medium', 'Hard', 'Very Hard', 'Extreme'][gameState.currentSentenceIndex];
            document.getElementById('difficultyLabel').textContent = `${diffLabel} — ${gameState.currentSentence.wordCount} words`;
            document.getElementById('wordCount').textContent = gameState.currentSentence.wordCount;
            document.getElementById('sentenceCount').textContent = (gameState.currentSentenceIndex + 1);
            gameState.sentenceRevealTime = getRevealDurationForWordCount(gameState.currentSentence.wordCount);
            
            // Show sentence, countdown ticks (3..2..1 style), then hide.
            document.getElementById('sentenceDisplay').textContent = gameState.currentSentence.original;
            document.getElementById('sentenceDisplay').style.color = '#fff';
            gameState.sentenceCurrentlyVisible = true;
            gameState.sentenceShownTime = new Date().toISOString();
            startRevealCountdown(gameState.sentenceRevealTime);
            resetTypingStopwatch();
            
            document.getElementById('readyBtn').style.display = 'none';
            document.getElementById('submitBtn').disabled = true;
            document.getElementById('userInput').value = '';
            document.getElementById('userInput').disabled = true;
            document.getElementById('answerFeedback').innerHTML = '';
            document.getElementById('correctSentenceDisplay').style.display = 'none';
            
            // After reveal duration, hide sentence and enable input.
            revealTimer = setTimeout(() => {
                hideSentence();
            }, gameState.sentenceRevealTime * 1000);
        }

        function hideSentence() {
            gameState.sentenceCurrentlyVisible = false;
            clearRevealCountdownTimer();
            document.getElementById('revealCountdown').textContent = '0';
            document.getElementById('sentenceDisplay').textContent = '💭 Type from memory...';
            document.getElementById('sentenceDisplay').classList.add('sentence-hidden');
            
            // Enable input for typing
            document.getElementById('userInput').disabled = false;
            document.getElementById('userInput').focus();
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('submitBtn').style.display = 'inline-block';
            startTypingStopwatch();
        }

        function getTypingMetricsForCurrentSentence(userAnswer) {
            const submitTimeMs = Date.now();
            const typingStart = typingStartMs || submitTimeMs;
            const totalTypingDurationMs = Math.max(0, submitTimeMs - typingStart);
            const firstKeyDelayMs = firstKeyTimeMs
                ? Math.max(0, firstKeyTimeMs - typingStart)
                : totalTypingDurationMs;
            const activeTypingDurationMs = firstKeyTimeMs
                ? Math.max(0, submitTimeMs - firstKeyTimeMs)
                : 0;

            const charsCount = userAnswer.length;
            const wordCount = userAnswer.trim().length ? userAnswer.trim().split(/\s+/).length : 0;

            const typingSpeedCharsPerSecond = activeTypingDurationMs > 0
                ? parseFloat((charsCount / (activeTypingDurationMs / 1000)).toFixed(2))
                : 0;

            const typingSpeedWordsPerMinute = activeTypingDurationMs > 0
                ? parseFloat((wordCount / (activeTypingDurationMs / 60000)).toFixed(2))
                : 0;

            return {
                typingStartTime: new Date(typingStart).toISOString(),
                firstKeyTime: firstKeyTimeMs ? new Date(firstKeyTimeMs).toISOString() : null,
                firstKeyDelayMs,
                totalTypingDurationMs,
                activeTypingDurationMs,
                typingSpeedCharsPerSecond,
                typingSpeedWordsPerMinute
            };
        }

        function normalizeSentence(text) {
            // Normalize for comparison: lowercase, trim, remove extra spaces
            return text.toLowerCase().trim().replace(/\s+/g, ' ');
        }

        function checkAnswer() {
            const userInput = document.getElementById('userInput').value.trim();
            const isCorrect = (normalizeSentence(userInput) === normalizeSentence(gameState.currentSentence.original));
            const typingMetrics = getTypingMetricsForCurrentSentence(userInput);
            
            clearTimeout(revealTimer);
            clearRevealCountdownTimer();
            clearTypingStopwatchTimer();
            document.getElementById('userInput').disabled = true;
            document.getElementById('submitBtn').disabled = true;
            
            // Show correct sentence
            document.getElementById('correctSentence').textContent = gameState.currentSentence.original;
            document.getElementById('correctSentenceDisplay').style.display = 'block';
            
            if (isCorrect) {
                const sentenceScore = 100;
                gameState.score += sentenceScore;
                document.getElementById('score').textContent = gameState.score;
                
                document.getElementById('answerFeedback').innerHTML = '<span class="text-success fw-bold">✅ PERFECT! +' + sentenceScore + ' points</span>';
            } else {
                document.getElementById('answerFeedback').innerHTML = '<span class="text-danger fw-bold">❌ Not quite right. Take note of the correct sentence above.</span>';
            }
            
            // Record result
            recordSentenceResult(isCorrect, userInput, typingMetrics);
            
            // Show appropriate button
            if (gameState.currentSentenceIndex >= gameState.totalSentences - 1) {
                document.getElementById('nextGameBtn').style.display = 'inline-block';
            } else {
                document.getElementById('nextBtn').style.display = 'inline-block';
            }
        }

        function recordSentenceResult(isCorrect, userAnswer, typingMetrics) {
            gameState.sentencesCompleted.push({
                wordCount: gameState.currentSentence.wordCount,
                original: gameState.currentSentence.original,
                userAnswer: userAnswer,
                isCorrect: isCorrect,
                startTime: gameState.sentenceStartTime,
                shownTime: gameState.sentenceShownTime,
                typingStartTime: typingMetrics.typingStartTime,
                firstKeyTime: typingMetrics.firstKeyTime,
                timeToFirstKeyMs: typingMetrics.firstKeyDelayMs,
                totalTypingDurationMs: typingMetrics.totalTypingDurationMs,
                activeTypingDurationMs: typingMetrics.activeTypingDurationMs,
                typingSpeedCharsPerSecond: typingMetrics.typingSpeedCharsPerSecond,
                typingSpeedWordsPerMinute: typingMetrics.typingSpeedWordsPerMinute,
                endTime: new Date().toISOString()
            });
        }

        function nextSentence() {
            gameState.currentSentenceIndex++;
            document.getElementById('sentenceDisplay').classList.remove('sentence-hidden');
            showReadyButton();
        }

        function playAgain() {
            saveGameData(false).then(() => {
                openPostGameSurvey('replay');
            });
        }

        function goToNextGame() {
            saveGameData(true).then(() => {
                openPostGameSurvey('next');
            });
        }

        function renderSection2Leaderboard() {
            const tbody = document.getElementById('section2ScoreboardBody');
            tbody.innerHTML = '';

            if (section2Leaderboard.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="text-muted">No records yet.</td></tr>';
                return;
            }

            section2Leaderboard.forEach(entry => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${entry.rank}</td>
                    <td>${entry.playerName}</td>
                    <td>${entry.score}</td>
                    <td>${entry.correctCount}</td>
                `;
                tbody.appendChild(row);
            });
        }

        async function fetchSection2Leaderboard() {
            try {
                const response = await fetch('/api/GameData/leaderboard/section2');
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to fetch Section 2 leaderboard:', data.error);
                    return;
                }

                section2Leaderboard.length = 0;
                section2Leaderboard.push(...(data.leaderboard || []));
                renderSection2Leaderboard();
            } catch (error) {
                console.error('Error fetching Section 2 leaderboard:', error);
            }
        }

        function openPostGameSurvey(action) {
            pendingSurveyAction = action;
            clearSurveyError();
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal'));
            modal.show();
        }

        function clearSurveyError() {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.style.display = 'none';
                errorEl.textContent = '';
            }
        }

        function showSurveyError(message) {
            const errorEl = document.getElementById('surveyError');
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.style.display = 'block';
            }
        }

        function getSurveyResponses() {
            const readValue = (name) => {
                const selected = document.querySelector(`input[name="${name}"]:checked`);
                return selected ? parseInt(selected.value, 10) : null;
            };

            return {
                frustrationStressAnnoyed: readValue('surveyFrustration'),
                timePressure: readValue('surveyTimePressure'),
                mentalEffort: readValue('surveyMentalEffort'),
                success: readValue('surveySuccess')
            };
        }

        document.getElementById('submitSurveyBtn').addEventListener('click', async function() {
            clearSurveyError();

            if (!currentSavedGameId) {
                showSurveyError('Please wait for the game to save before continuing.');
                return;
            }

            const surveyResponses = getSurveyResponses();
            if (Object.values(surveyResponses).some(value => value == null)) {
                showSurveyError('Please answer all four questions before continuing.');
                return;
            }

            try {
                const response = await fetch('/api/GameData/survey', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        gameId: currentSavedGameId,
                        surveyResponses: surveyResponses
                    })
                });

                const data = await response.json();
                if (!response.ok || !data.success) {
                    showSurveyError(data.error || 'Could not save survey answers.');
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(document.getElementById('postGameSurveyModal')).hide();

                if (pendingSurveyAction === 'next') {
                    window.location.href = '/Questions/Section3';
                } else if (pendingSurveyAction === 'replay') {
                    await initializeGame();
                }
            } catch (error) {
                showSurveyError(error.message || 'Could not save survey answers.');
            }
        });

        async function saveGameData(completed) {
            clearRevealCountdownTimer();
            clearTypingStopwatchTimer();

            // Stop tracking
            mouseTracker.stopTracking();
            headTracker.stopTracking();
            const mouseData = mouseTracker.getData();
            const headData = headTracker.getData();
            
            // Collect behavior data
            const behaviorData = behaviorLogger.endGame();
            
            // Fix: Ensure all dates in hesitationPauses are proper ISO strings and filter out incomplete pauses
            if (behaviorData.hesitationPauses) {
                behaviorData.hesitationPauses = behaviorData.hesitationPauses
                    .filter(pause => pause.endTime != null)
                    .map(pause => ({
                        ...pause,
                        startTime: pause.startTime ? new Date(pause.startTime).toISOString() : null,
                        endTime: pause.endTime ? new Date(pause.endTime).toISOString() : null
                    }));
            }
            
            // Calculate accuracy
            const correctCount = gameState.sentencesCompleted.filter(s => s.isCorrect).length;
            const totalTypingDurationMs = gameState.sentencesCompleted
                .reduce((sum, sentence) => sum + (sentence.totalTypingDurationMs || 0), 0);

            const toMs = (value) => {
                const ms = Date.parse(value || '');
                return Number.isNaN(ms) ? null : ms;
            };

            const isWithinRange = (timestamp, startTime, endTime) => {
                const point = toMs(timestamp);
                const start = toMs(startTime);
                const end = toMs(endTime);

                if (point === null || start === null || end === null) {
                    return false;
                }

                return point >= start && point <= end;
            };

            const words = gameState.sentencesCompleted.map((sentence, index) => {
                const typingStart = sentence.typingStartTime;
                const submitTime = sentence.endTime;

                const wordTypingEvents = (behaviorData.typingEvents || []).filter(event =>
                    isWithinRange(event.timestamp, typingStart, submitTime)
                );

                const wordHesitationPauses = (behaviorData.hesitationPauses || []).filter(pause => {
                    const pauseStart = toMs(pause.startTime);
                    const pauseEnd = toMs(pause.endTime);
                    const typingStartMs = toMs(typingStart);
                    const submitTimeMs = toMs(submitTime);

                    if (pauseStart === null || pauseEnd === null || typingStartMs === null || submitTimeMs === null) {
                        return false;
                    }

                    return pauseEnd >= typingStartMs && pauseStart <= submitTimeMs;
                });

                const wordMouseMovements = (mouseData.movements || []).filter(movement =>
                    isWithinRange(movement.timestamp, typingStart, submitTime)
                );

                const wordHeadSamples = (headData.headSamples || []).filter(sample =>
                    isWithinRange(sample.timestamp, typingStart, submitTime)
                );

                const wordHeadPositions = (headData.headPositions || []).filter(position =>
                    isWithinRange(position.timestamp, typingStart, submitTime)
                );

                const lookAwayCount = wordHeadSamples.filter(sample => sample.isLookAway).length;
                const headTiltCount = wordHeadSamples.filter(sample => sample.isHeadTilt).length;

                const headMovementSamples = wordHeadPositions.filter(position => (position.movementDelta || 0) > 0);
                const averageHeadMovement = headMovementSamples.length > 0
                    ? parseFloat((headMovementSamples.reduce((sum, position) => sum + (position.movementDelta || 0), 0) / headMovementSamples.length).toFixed(2))
                    : 0;

                const avgTypingSpeed = wordTypingEvents.length > 0
                    ? parseFloat((wordTypingEvents.reduce((sum, event) => sum + (event.speed || 0), 0) / wordTypingEvents.length).toFixed(2))
                    : 0;

                const avgMouseSpeed = wordMouseMovements.length > 0
                    ? parseFloat((wordMouseMovements.reduce((sum, movement) => sum + (movement.speed || 0), 0) / wordMouseMovements.length).toFixed(2))
                    : 0;

                return {
                    sentenceIndex: index + 1,
                    wordCount: sentence.wordCount,
                    sentence: sentence.original,
                    typingStartTime: typingStart,
                    firstKeyTime: sentence.firstKeyTime,
                    submitTime: submitTime,
                    timeToFirstKeyMs: sentence.timeToFirstKeyMs || 0,
                    timeToSubmitAfterDisappearMs: sentence.totalTypingDurationMs || 0,
                    behaviorData: {
                        typingEvents: wordTypingEvents,
                        hesitationPauses: wordHesitationPauses,
                        mouseMovements: wordMouseMovements,
                        headSamples: wordHeadSamples,
                        lookAwayCount: lookAwayCount,
                        headTiltCount: headTiltCount,
                        averageHeadMovement: averageHeadMovement,
                        averageTypingSpeed: avgTypingSpeed,
                        averageMouseSpeed: avgMouseSpeed
                    }
                };
            });

            const avgStartWriting = words.length > 0
                ? words.reduce((sum, word) => sum + (word.timeToFirstKeyMs || 0), 0) / words.length
                : 0;

            const avgSubmitTime = words.length > 0
                ? words.reduce((sum, word) => sum + (word.timeToSubmitAfterDisappearMs || 0), 0) / words.length
                : 0;
            
            // Prepare game result
            const gameResult = {
                sessionId: gameState.sessionId,
                gameType: "Sentence Memory Test",
                sectionNumber: 2,
                startTime: gameState.startTime,
                endTime: new Date().toISOString(),
                score: gameState.score,
                surveyavg: 0,
                totalTimeSeconds: totalTypingDurationMs / 1000,
                completed: completed,
                words: words,
                
                behaviorData: {
                    mouseMovements: mouseData.movements || [],
                    typingEvents: behaviorData.typingEvents || [],
                    hesitationPauses: behaviorData.hesitationPauses || [],
                    averageMouseSpeed: mouseData.averageSpeed || 0,
                    averageTypingSpeed: behaviorData.averageTypingSpeed || 0,
                    averageHeadMovement: headData.averageHeadMovement || 0,
                    lookAwayCount: headData.lookAwayCount || 0,
                    headTiltCount: headData.tiltCount || 0,
                    heartRate: null,
                    heartRatebefore: null
                },
                
                gameData: {
                    sentencesCompleted: gameState.sentencesCompleted,
                    correctCount: correctCount,
                    totalSentences: gameState.totalSentences,
                    accuracy: (correctCount / gameState.totalSentences) * 100,
                    avgStartWriting: Number(avgStartWriting.toFixed(2)),
                    avgSubmitTime: Number(avgSubmitTime.toFixed(2))
                }
            };
            
            try {
                const response = await fetch('/api/GameData/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(gameResult)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showGlobalFeedback('Game saved!', true);
                    currentSavedGameId = data.id;
                    await sendMLPrediction(
                        {
                            gameId: data.id,
                            sessionId: gameResult.sessionId,
                            totalTimeSeconds: gameResult.totalTimeSeconds,
                            heartRate: gameResult.behaviorData.heartRate,
                            heartRateBefore: gameResult.behaviorData.heartRatebefore,
                            heartRateDifference: gameResult.behaviorData.heartRateDifference,
                            gameTypeEncoded: 2,
                            sectionNumber: gameResult.sectionNumber,
                            score: gameResult.score,
                            completed: gameResult.completed
                        },
                        {
                            mouseMovementsCount: (gameResult.behaviorData.mouseMovements || []).length,
                            averageMouseSpeed: gameResult.behaviorData.averageMouseSpeed,
                            typingEventsCount: (gameResult.behaviorData.typingEvents || []).length,
                            averageTypingSpeed: gameResult.behaviorData.averageTypingSpeed,
                            hesitationPausesCount: (gameResult.behaviorData.hesitationPauses || []).length
                        },
                        {
                            averageHeadMovement: gameResult.behaviorData.averageHeadMovement,
                            lookAwayCount: gameResult.behaviorData.lookAwayCount,
                            headTiltCount: gameResult.behaviorData.headTiltCount
                        }
                    );
                    fetchSection2Leaderboard();
                } else {
                    console.error("Save failed:", data.error);
                }
            } catch (error) {
                console.error("Error saving:", error);
            }
        }

        async function sendMLPrediction(gameData, behaviorData, headData) {
            const payload = {
                gameId: gameData.gameId ?? null,
                sessionId: gameData.sessionId ?? gameState.sessionId,
                mouseMovementsCount: behaviorData.mouseMovementsCount ?? 0,
                averageMouseSpeed: behaviorData.averageMouseSpeed ?? 0,
                typingEventsCount: behaviorData.typingEventsCount ?? 0,
                averageTypingSpeed: behaviorData.averageTypingSpeed ?? 0,
                hesitationPausesCount: behaviorData.hesitationPausesCount ?? 0,
                averageHeadMovement: headData.averageHeadMovement ?? 0,
                lookAwayCount: headData.lookAwayCount ?? 0,
                headTiltCount: headData.headTiltCount ?? 0,
                totalTimeSeconds: gameData.totalTimeSeconds ?? 0,
                heartRate: gameData.heartRate ?? null,
                heartRatebefore: gameData.heartRateBefore ?? null,
                heartRateDifference: gameData.heartRateDifference ?? null,
                age: sessionData.age ?? 0,
                gameType: gameData.gameTypeEncoded ?? 0,
                sectionNumber: gameData.sectionNumber ?? 1,
                score: gameData.score ?? 0,
                completed: gameData.completed ? 1 : 0
            };

            try {
                const response = await fetch('/api/GameData/ml-predict', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                console.log('ML Result:', result);

                showMLResult(result);
            } catch (err) {
                console.error('ML prediction failed:', err);
            }
        }

        function showMLResult(result) {
            const box = document.getElementById('ml-result-box');
            if (box) {
                box.innerHTML = '';
                box.style.display = 'none';
            }
        }

        function showGlobalFeedback(message, isSuccess) {
            const feedback = document.getElementById('feedbackMessage');
            feedback.textContent = message;
            feedback.className = isSuccess ? 'alert alert-success' : 'alert alert-danger';
            feedback.style.display = 'block';
            
            setTimeout(() => {
                feedback.style.display = 'none';
            }, 2000);
        }

        // Event listeners
        document.getElementById('readyBtn').addEventListener('click', startSentence);
        document.getElementById('submitBtn').addEventListener('click', checkAnswer);
        document.getElementById('nextBtn').addEventListener('click', nextSentence);
        document.getElementById('playAgainBtn').addEventListener('click', playAgain);
        document.getElementById('nextGameBtn').addEventListener('click', goToNextGame);
        
        // Enter key to submit
        document.getElementById('userInput').addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !document.getElementById('submitBtn').disabled) {
                checkAnswer();
            }
        });

        document.getElementById('userInput').addEventListener('input', () => {
            if (!typingStartMs || firstKeyTimeMs) {
                return;
            }

            const userInput = document.getElementById('userInput').value;
            if (!userInput.length) {
                return;
            }

            firstKeyTimeMs = Date.now();
        });

        console.log("Sentence Memory Test initialized with session:", gameState.sessionId);
    </script>
}