@{
    ViewData["Title"] = "Cognitive Overload LMS";
}

<style>
    .landing-shell {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem 1rem 1.75rem;
    }

    .landing-card {
        width: 100%;
        max-width: 980px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 28px;
        box-shadow: 0 28px 70px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(16px);
        overflow: hidden;
    }

    .landing-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
    }

    .landing-hero {
        padding: 2.2rem;
        background:
            radial-gradient(circle at top left, rgba(72, 198, 239, 0.18), transparent 30%),
            radial-gradient(circle at bottom left, rgba(108, 99, 255, 0.2), transparent 32%);
        color: #f4f8ff;
    }

    .landing-panel {
        padding: 2.2rem;
        background: rgba(7, 12, 23, 0.46);
        border-left: 1px solid rgba(255, 255, 255, 0.08);
        color: #f4f8ff;
    }

    .landing-badge {
        display: inline-block;
        margin-bottom: 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .landing-title {
        font-size: clamp(1.8rem, 3.4vw, 2.7rem);
        line-height: 1.05;
        font-weight: 900;
        margin-bottom: 0.7rem;
        color: #fff;
    }

    .landing-copy {
        color: rgba(244, 248, 255, 0.72);
        font-size: 0.94rem;
        line-height: 1.55;
        margin-bottom: 1rem;
        max-width: 42ch;
    }

    .landing-highlights {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.65rem;
        margin-top: 0.8rem;
    }

    .landing-highlight {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        padding: 0.72rem 0.78rem;
    }

    .landing-highlight-title {
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
    }

    .landing-highlight-copy {
        color: rgba(244, 248, 255, 0.62);
        font-size: 0.74rem;
        line-height: 1.35;
        margin: 0;
    }

    .launch-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.35rem;
    }

    .launch-copy {
        color: rgba(244, 248, 255, 0.62);
        font-size: 0.86rem;
        margin-bottom: 1rem;
    }

    .participant-form {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.65rem 0.8rem;
        margin-bottom: 0.9rem;
    }

    .participant-field {
        margin: 0;
    }

    .participant-field.full {
        grid-column: 1 / -1;
    }

    .launch-label {
        display: block;
        margin-bottom: 0.28rem;
        color: rgba(244, 248, 255, 0.82);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .launch-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.08);
        border: 2px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 12px;
        padding: 0.65rem 0.75rem;
        font-size: 0.92rem;
        margin: 0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .launch-input::placeholder {
        color: rgba(244, 248, 255, 0.34);
    }

    .launch-input:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(72, 198, 239, 0.7);
        box-shadow: 0 0 0 6px rgba(72, 198, 239, 0.12);
    }

    .launch-btn {
        width: 100%;
        border: 0;
        border-radius: 999px;
        padding: 0.78rem 1.1rem;
        font-size: 0.92rem;
        font-weight: 800;
        color: #fff;
        background: linear-gradient(90deg, #6c63ff, #48c6ef);
        box-shadow: 0 16px 28px rgba(72, 198, 239, 0.22);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    .launch-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 22px 34px rgba(72, 198, 239, 0.26);
    }

    .sections-strip {
        margin-top: 0.9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    .sections-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.36rem 0.62rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.07);
        font-size: 0.73rem;
        color: rgba(244, 248, 255, 0.9);
    }

    .section-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .section-dot.memory { background: #e94560; box-shadow: 0 0 12px rgba(233, 69, 96, 0.65); }
    .section-dot.words { background: #48c6ef; box-shadow: 0 0 12px rgba(72, 198, 239, 0.65); }
    .section-dot.arrow { background: #f5a623; box-shadow: 0 0 12px rgba(245, 166, 35, 0.65); }

    .followup-note {
        margin-top: 0.55rem;
        color: rgba(244, 248, 255, 0.55);
        font-size: 0.72rem;
        line-height: 1.35;
    }

    @@media (max-width: 991.98px) {
        .landing-grid {
            grid-template-columns: 1fr;
        }

        .landing-panel {
            border-left: 0;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .participant-form {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .landing-shell {
            padding: 1rem 0.75rem 2rem;
        }

        .landing-hero,
        .landing-panel {
            padding: 1.25rem;
        }

        .landing-highlights {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="landing-shell">
    <div class="landing-card">
        <div class="landing-grid">
            <section class="landing-hero">
                <span class="landing-badge">Research Game Suite</span>
                <h1 class="landing-title">Measure cognitive overload through play.</h1>
                <p class="landing-copy">
                    Participants complete three fast-paced mini games while the system captures behavioral signals such as mouse speed,
                    typing patterns, hesitation pauses, and head movement.
                </p>

                <div class="landing-highlights">
                    <div class="landing-highlight">
                        <div class="landing-highlight-title">Memory</div>
                        <p class="landing-highlight-copy">Repeat visual patterns under time pressure.</p>
                    </div>
                    <div class="landing-highlight">
                        <div class="landing-highlight-title">Language</div>
                        <p class="landing-highlight-copy">Unscramble category words before time runs out.</p>
                    </div>
                    <div class="landing-highlight">
                        <div class="landing-highlight-title">Precision</div>
                        <p class="landing-highlight-copy">Shoot arrows without colliding with existing ones.</p>
                    </div>
                </div>
            </section>

            <aside class="landing-panel">
                <h2 class="launch-title">Begin assessment</h2>
                <p class="launch-copy">Enter participant details to start a new tracked session.</p>

                <div class="participant-form">
                    <div class="participant-field">
                        <label for="firstName" class="launch-label">First Name</label>
                        <input type="text" class="launch-input" id="firstName" placeholder="First name" required>
                    </div>

                    <div class="participant-field">
                        <label for="lastName" class="launch-label">Last Name</label>
                        <input type="text" class="launch-input" id="lastName" placeholder="Last name" required>
                    </div>

                    <div class="participant-field">
                        <label for="age" class="launch-label">Age</label>
                        <input type="number" min="1" max="120" class="launch-input" id="age" placeholder="Age" required>
                    </div>

                    <div class="participant-field">
                        <label for="major" class="launch-label">Major</label>
                        <input type="text" class="launch-input" id="major" placeholder="Major" required>
                    </div>

                    <div class="participant-field">
                        <label for="phoneNumber" class="launch-label">Phone Number</label>
                        <input type="tel" class="launch-input" id="phoneNumber" placeholder="Phone number" required>
                    </div>

                    <div class="participant-field">
                        <label for="email" class="launch-label">Email for Follow-up</label>
                        <input type="email" class="launch-input" id="email" placeholder="Email address" required>
                    </div>
                </div>

                <button id="startBtn" class="launch-btn">Start session</button>

                <div class="sections-strip" aria-label="Sections included">
                    <span class="sections-chip"><span class="section-dot memory"></span>Memory pattern</span>
                    <span class="sections-chip"><span class="section-dot words"></span>Sentence memory</span>
                    <span class="sections-chip"><span class="section-dot arrow"></span>Arrow precision</span>
                </div>

                <p class="followup-note">We may contact you by email or phone number for testing follow-up.</p>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const indexBehaviorTracker = {
            mouseMovements: [],
            typingEvents: [],
            lastMousePosition: null,
            lastMouseTime: null,
            lastMouseSpeed: 0,
            lastKeyTime: null,
            maxSamples: 600,
            isActive: true
        };

        function onIndexMouseMove(e) {
            if (!indexBehaviorTracker.isActive) {
                return;
            }

            const now = Date.now();
            if (indexBehaviorTracker.lastMousePosition && indexBehaviorTracker.lastMouseTime) {
                const dx = e.clientX - indexBehaviorTracker.lastMousePosition.x;
                const dy = e.clientY - indexBehaviorTracker.lastMousePosition.y;
                const dt = (now - indexBehaviorTracker.lastMouseTime) / 1000;

                if (dt > 0) {
                    const distance = Math.sqrt((dx * dx) + (dy * dy));
                    const speed = distance / dt;
                    const acceleration = (speed - indexBehaviorTracker.lastMouseSpeed) / dt;

                    indexBehaviorTracker.mouseMovements.push({
                        timestamp: new Date(now).toISOString(),
                        x: Math.round(e.clientX),
                        y: Math.round(e.clientY),
                        speed: parseFloat(speed.toFixed(2)),
                        acceleration: parseFloat(acceleration.toFixed(2))
                    });

                    if (indexBehaviorTracker.mouseMovements.length > indexBehaviorTracker.maxSamples) {
                        indexBehaviorTracker.mouseMovements.shift();
                    }

                    indexBehaviorTracker.lastMouseSpeed = speed;
                }
            }

            indexBehaviorTracker.lastMousePosition = { x: e.clientX, y: e.clientY };
            indexBehaviorTracker.lastMouseTime = now;
        }

        function onIndexKeyDown(e) {
            if (!indexBehaviorTracker.isActive || e.repeat) {
                return;
            }

            const target = e.target;
            const isInputField = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
            if (!isInputField) {
                return;
            }

            const now = Date.now();
            const delay = indexBehaviorTracker.lastKeyTime ? now - indexBehaviorTracker.lastKeyTime : 0;
            const speed = delay > 0 ? 1000 / delay : 0;

            indexBehaviorTracker.typingEvents.push({
                timestamp: new Date(now).toISOString(),
                key: e.key,
                delaySinceLastKeyMs: Math.round(delay),
                speed: parseFloat(speed.toFixed(2))
            });

            if (indexBehaviorTracker.typingEvents.length > indexBehaviorTracker.maxSamples) {
                indexBehaviorTracker.typingEvents.shift();
            }

            indexBehaviorTracker.lastKeyTime = now;
        }

        function buildIndexBehaviorData() {
            const mouseMovements = indexBehaviorTracker.mouseMovements;
            const typingEvents = indexBehaviorTracker.typingEvents;
            const hesitationThresholdMs = 2000;

            const hesitationPauses = typingEvents
                .filter(event => (event.delaySinceLastKeyMs || 0) >= hesitationThresholdMs)
                .map(event => {
                    const end = new Date(event.timestamp);
                    const start = new Date(end.getTime() - event.delaySinceLastKeyMs);

                    return {
                        startTime: start.toISOString(),
                        endTime: end.toISOString(),
                        durationSeconds: parseFloat((event.delaySinceLastKeyMs / 1000).toFixed(2)),
                        location: 'index'
                    };
                });

            const averageMouseSpeed = mouseMovements.length > 0
                ? parseFloat((mouseMovements.reduce((sum, m) => sum + (m.speed || 0), 0) / mouseMovements.length).toFixed(2))
                : 0;

            const averageTypingSpeed = typingEvents.length > 0
                ? parseFloat((typingEvents.reduce((sum, t) => sum + (t.speed || 0), 0) / typingEvents.length).toFixed(2))
                : 0;

            return {
                mouseMovements,
                typingEvents,
                hesitationPauses,
                averageMouseSpeed,
                averageTypingSpeed,
                heartRate: 0,
                heartRatebefore: 0
            };
        }

        function stopIndexBehaviorTracking() {
            indexBehaviorTracker.isActive = false;
            document.removeEventListener('mousemove', onIndexMouseMove);
            document.removeEventListener('keydown', onIndexKeyDown);
        }

        document.addEventListener('mousemove', onIndexMouseMove);
        document.addEventListener('keydown', onIndexKeyDown);

        document.getElementById('startBtn').addEventListener('click', async function() {
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const ageText = document.getElementById('age').value.trim();
            const major = document.getElementById('major').value.trim();
            const phoneNumber = document.getElementById('phoneNumber').value.trim();
            const email = document.getElementById('email').value.trim();

            if (!firstName || !lastName || !ageText || !major || !phoneNumber || !email) {
                alert('Please fill in all participant details.');
                return;
            }

            const age = parseInt(ageText, 10);
            if (Number.isNaN(age) || age < 1 || age > 120) {
                alert('Please enter a valid age between 1 and 120.');
                return;
            }

            const sessionPayload = {
                firstName,
                lastName,
                age,
                major,
                phoneNumber,
                email,
                indexBehaviorData: buildIndexBehaviorData()
            };
            
            try {
                const response = await fetch('/Home/StartSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(sessionPayload)
                });
                
                const data = await response.json();

                if (!response.ok || !data.success) {
                    alert(data.error || 'Could not start session. Please check the form and try again.');
                    return;
                }
                
                // Store sessionId in sessionStorage for later use
                sessionStorage.setItem('sessionId', data.sessionId);
                sessionStorage.setItem('userName', `${firstName} ${lastName}`);

                stopIndexBehaviorTracking();
                
                // Redirect to first section
                window.location.href = '/Questions/Section1';
            } catch (error) {
                console.error('Error starting session:', error);
                alert('Error starting session. Please try again.');
            }
        });
    </script>
}