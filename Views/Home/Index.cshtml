@{
    ViewData["Title"] = "Cognitive Overload LMS";
}

<style>
    :root {
        color-scheme: dark;
    }

    .landing-shell {
        min-height: calc(100vh - 150px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem 2.5rem;
        background:
            radial-gradient(circle at top, rgba(72, 198, 239, 0.12), transparent 34%),
            radial-gradient(circle at bottom, rgba(108, 99, 255, 0.12), transparent 28%);
    }

    .landing-card {
        width: 100%;
        max-width: 980px;
        color: #f4f8ff;
        text-align: center;
        position: relative;
    }

    .landing-card::before {
        content: "";
        position: absolute;
        inset: 1.25rem 0.75rem auto;
        height: 120px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(72, 198, 239, 0.16), transparent 70%);
        filter: blur(8px);
        pointer-events: none;
        z-index: 0;
    }

    .landing-surface {
        position: relative;
        z-index: 1;
        padding: 0;
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 24px;
        background: rgba(6, 11, 22, 0.72);
        box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(14px);
        overflow: hidden;
    }

    .landing-grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
    }

    .landing-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.95rem;
        padding: 0.36rem 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.06);
        color: rgba(244, 248, 255, 0.88);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .landing-title {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.08;
        font-weight: 900;
        color: #fff;
    }

    .landing-copy {
        margin: 0.7rem auto 0;
        max-width: 40ch;
        color: rgba(244, 248, 255, 0.75);
        font-size: 0.95rem;
        line-height: 1.45;
    }

    .landing-section {
        margin-top: 1.15rem;
    }

    .section-heading {
        margin: 0 0 0.85rem;
        color: rgba(244, 248, 255, 0.54);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

    .game-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.65rem;
        text-align: left;
    }

    .game-item {
        display: flex;
        gap: 0.8rem;
        align-items: flex-start;
        padding: 0.68rem 0.8rem;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .game-icon {
        width: 2rem;
        flex: 0 0 2rem;
        text-align: center;
        font-size: 1.08rem;
        line-height: 1.4;
    }

    .game-text {
        color: rgba(244, 248, 255, 0.74);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .game-text strong {
        display: block;
        color: #fff;
        font-size: 0.98rem;
        font-weight: 800;
        margin-bottom: 0.1rem;
    }

    .participant-form {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.7rem 0.75rem;
        text-align: left;
    }

    .participant-field.full {
        grid-column: 1 / -1;
    }

    .launch-label {
        display: block;
        margin-bottom: 0.28rem;
        color: rgba(244, 248, 255, 0.82);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .launch-input {
        width: 100%;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        padding: 0.78rem 0.85rem;
        font-size: 0.95rem;
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, transform 0.18s ease;
    }

    .launch-input::placeholder {
        color: rgba(244, 248, 255, 0.34);
    }

    .launch-input:focus {
        outline: none;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(72, 198, 239, 0.72);
        box-shadow: 0 0 0 4px rgba(72, 198, 239, 0.1);
        transform: translateY(-1px);
    }

    .privacy-list {
        margin: 0.85rem 0 0;
        padding-left: 1.1rem;
        text-align: left;
        color: rgba(244, 248, 255, 0.78);
        font-size: 0.84rem;
        line-height: 1.45;
    }

    .consent-row {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-top: 0.75rem;
        text-align: left;
        color: rgba(244, 248, 255, 0.88);
        font-size: 0.9rem;
        line-height: 1.45;
    }

    .consent-row input {
        margin-top: 0.18rem;
        flex: 0 0 auto;
    }

    .launch-btn {
        width: 100%;
        margin-top: 0.8rem;
        border: 0;
        border-radius: 999px;
        padding: 0.92rem 1.1rem;
        background: linear-gradient(90deg, #2f77ff, #48c6ef);
        color: #fff;
        font-size: 1rem;
        font-weight: 800;
        box-shadow: 0 18px 32px rgba(47, 119, 255, 0.25);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    }

    .launch-btn:hover {
        transform: translateY(-2px);
        filter: brightness(1.03);
        box-shadow: 0 22px 38px rgba(47, 119, 255, 0.32);
    }

    .launch-btn:focus-visible,
    .launch-input:focus-visible,
    .consent-row input:focus-visible {
        outline: 2px solid rgba(72, 198, 239, 0.8);
        outline-offset: 2px;
    }

    .microcopy {
        margin: 0.55rem 0 0;
        color: rgba(244, 248, 255, 0.56);
        font-size: 0.76rem;
        line-height: 1.4;
    }

    @@media (min-width: 768px) {
        .participant-field:nth-child(odd):last-child {
            grid-column: 1 / -1;
        }
    }

    .landing-hero {
        padding: 1.6rem 1.6rem 1.5rem;
        text-align: left;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
        background:
            radial-gradient(circle at top left, rgba(72, 198, 239, 0.12), transparent 36%),
            radial-gradient(circle at bottom left, rgba(108, 99, 255, 0.11), transparent 30%);
    }

    .landing-panel {
        padding: 1.6rem 1.6rem 1.5rem;
        text-align: left;
        background: rgba(8, 13, 24, 0.5);
    }

    .landing-panel .section-heading,
    .landing-panel .launch-label,
    .landing-panel .privacy-list,
    .landing-panel .consent-row,
    .landing-panel .microcopy {
        text-align: left;
    }

    .landing-panel .landing-section {
        margin-top: 0;
    }

    .hero-copy-group {
        max-width: 44ch;
    }

    .hero-list {
        list-style: none;
        padding: 0;
        margin: 1rem 0 0;
        display: grid;
        gap: 0.6rem;
    }

    .hero-list-item {
        display: flex;
        gap: 0.7rem;
        align-items: flex-start;
        color: rgba(244, 248, 255, 0.76);
        font-size: 0.92rem;
        line-height: 1.45;
    }

    .hero-list-item strong {
        display: block;
        color: #fff;
        font-weight: 800;
        margin-bottom: 0.08rem;
    }

    .hero-list-icon {
        width: 1.7rem;
        flex: 0 0 1.7rem;
        text-align: center;
        font-size: 1rem;
        line-height: 1.35;
        margin-top: 0.05rem;
    }

    .hero-footnote {
        margin: 0.95rem 0 0;
        color: rgba(244, 248, 255, 0.58);
        font-size: 0.76rem;
        line-height: 1.45;
    }

    @@media (max-width: 767.98px) {
        .landing-shell {
            padding: 1.1rem 0.8rem 1.6rem;
        }

        .landing-grid {
            grid-template-columns: 1fr;
        }

        .landing-hero {
            border-right: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .landing-hero,
        .landing-panel {
            padding: 1.2rem 1rem 1rem;
        }

        .landing-copy {
            font-size: 0.94rem;
        }

        .game-item {
            padding: 0.8rem 0.82rem;
        }

        .participant-form {
            grid-template-columns: 1fr;
        }

        .launch-input {
            padding: 0.72rem 0.78rem;
        }

        .launch-btn {
            padding: 0.95rem 1rem;
        }
    }
</style>

<div class="landing-shell">
    <main class="landing-card">
        <div class="landing-surface">
            <div class="landing-grid">
                <section class="landing-hero" aria-label="Study overview">
                    <span class="landing-badge">Academic Study</span>
                    <div class="hero-copy-group">
                        <h1 class="landing-title">Measure cognitive overload through play</h1>
                        <p class="landing-copy">Play 3 short tasks. We analyze interaction behavior.</p>

                        <ul class="hero-list" aria-label="Tasks">
                            <li class="hero-list-item">
                                <div class="hero-list-icon" aria-hidden="true">🧠</div>
                                <div><strong>Memory</strong><span>Repeat patterns under pressure</span></div>
                            </li>
                            <li class="hero-list-item">
                                <div class="hero-list-icon" aria-hidden="true">🔤</div>
                                <div><strong>Language</strong><span>Unscramble words quickly</span></div>
                            </li>
                            <li class="hero-list-item">
                                <div class="hero-list-icon" aria-hidden="true">🎯</div>
                                <div><strong>Precision</strong><span>Avoid collisions while shooting</span></div>
                            </li>
                        </ul>

                        <p class="hero-footnote">Short, focused tasks. Built for an academic research setting.</p>
                    </div>
                </section>

                <section class="landing-panel" aria-label="Participant details">
                    <h2 class="section-heading">Participant details</h2>
                    <div class="participant-form">
                        <div class="participant-field">
                            <label for="firstName" class="launch-label">First Name</label>
                            <input type="text" class="launch-input" id="firstName" required>
                        </div>

                        <div class="participant-field">
                            <label for="lastName" class="launch-label">Last Name</label>
                            <input type="text" class="launch-input" id="lastName" required>
                        </div>

                        <div class="participant-field">
                            <label for="age" class="launch-label">Age</label>
                            <input type="number" min="1" max="120" class="launch-input" id="age" required>
                        </div>

                        <div class="participant-field">
                            <label for="major" class="launch-label">Major</label>
                            <input type="text" class="launch-input" id="major" required>
                        </div>

                        <div class="participant-field">
                            <label for="email" class="launch-label">Email</label>
                            <input type="email" class="launch-input" id="email" required>
                        </div>

                        <div class="participant-field">
                            <label for="phoneNumber" class="launch-label">Phone</label>
                            <input type="tel" class="launch-input" id="phoneNumber" required>
                        </div>
                    </div>

                    <ul class="privacy-list">
                        <li>No video is recorded or stored</li>
                        <li>Data is used for academic research only</li>
                        <li>Camera is used only for head movement tracking</li>
                    </ul>

                    <label class="consent-row" for="consentCheckbox">
                        <input type="checkbox" id="consentCheckbox">
                        <span>I consent to behavior data collection</span>
                    </label>

                    <button id="startBtn" class="launch-btn">Start Assessment</button>
                </section>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        const indexBehaviorTracker = {
            mouseMovements: [],
            typingEvents: [],
            lastMousePosition: null,
            lastMouseTime: null,
            lastMouseSpeed: 0,
            lastKeyTime: null,
            maxSamples: 600,
            isActive: true
        };

        function onIndexMouseMove(e) {
            if (!indexBehaviorTracker.isActive) {
                return;
            }

            const now = Date.now();
            if (indexBehaviorTracker.lastMousePosition && indexBehaviorTracker.lastMouseTime) {
                const dx = e.clientX - indexBehaviorTracker.lastMousePosition.x;
                const dy = e.clientY - indexBehaviorTracker.lastMousePosition.y;
                const dt = (now - indexBehaviorTracker.lastMouseTime) / 1000;

                if (dt > 0) {
                    const distance = Math.sqrt((dx * dx) + (dy * dy));
                    const speed = distance / dt;
                    const acceleration = (speed - indexBehaviorTracker.lastMouseSpeed) / dt;

                    indexBehaviorTracker.mouseMovements.push({
                        timestamp: new Date(now).toISOString(),
                        x: Math.round(e.clientX),
                        y: Math.round(e.clientY),
                        speed: parseFloat(speed.toFixed(2)),
                        acceleration: parseFloat(acceleration.toFixed(2))
                    });

                    if (indexBehaviorTracker.mouseMovements.length > indexBehaviorTracker.maxSamples) {
                        indexBehaviorTracker.mouseMovements.shift();
                    }

                    indexBehaviorTracker.lastMouseSpeed = speed;
                }
            }

            indexBehaviorTracker.lastMousePosition = { x: e.clientX, y: e.clientY };
            indexBehaviorTracker.lastMouseTime = now;
        }

        function onIndexKeyDown(e) {
            if (!indexBehaviorTracker.isActive || e.repeat) {
                return;
            }

            const target = e.target;
            const isInputField = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement;
            if (!isInputField) {
                return;
            }

            const now = Date.now();
            const delay = indexBehaviorTracker.lastKeyTime ? now - indexBehaviorTracker.lastKeyTime : 0;
            const speed = delay > 0 ? 1000 / delay : 0;

            indexBehaviorTracker.typingEvents.push({
                timestamp: new Date(now).toISOString(),
                key: e.key,
                delaySinceLastKeyMs: Math.round(delay),
                speed: parseFloat(speed.toFixed(2))
            });

            if (indexBehaviorTracker.typingEvents.length > indexBehaviorTracker.maxSamples) {
                indexBehaviorTracker.typingEvents.shift();
            }

            indexBehaviorTracker.lastKeyTime = now;
        }

        function buildIndexBehaviorData() {
            const mouseMovements = indexBehaviorTracker.mouseMovements;
            const typingEvents = indexBehaviorTracker.typingEvents;
            const hesitationThresholdMs = 2000;

            const hesitationPauses = typingEvents
                .filter(event => (event.delaySinceLastKeyMs || 0) >= hesitationThresholdMs)
                .map(event => {
                    const end = new Date(event.timestamp);
                    const start = new Date(end.getTime() - event.delaySinceLastKeyMs);

                    return {
                        startTime: start.toISOString(),
                        endTime: end.toISOString(),
                        durationSeconds: parseFloat((event.delaySinceLastKeyMs / 1000).toFixed(2)),
                        location: 'index'
                    };
                });

            const averageMouseSpeed = mouseMovements.length > 0
                ? parseFloat((mouseMovements.reduce((sum, m) => sum + (m.speed || 0), 0) / mouseMovements.length).toFixed(2))
                : 0;

            const averageTypingSpeed = typingEvents.length > 0
                ? parseFloat((typingEvents.reduce((sum, t) => sum + (t.speed || 0), 0) / typingEvents.length).toFixed(2))
                : 0;

            return {
                mouseMovements,
                typingEvents,
                hesitationPauses,
                averageMouseSpeed,
                averageTypingSpeed,
                heartRate: 0,
                heartRatebefore: 0
            };
        }

        function stopIndexBehaviorTracking() {
            indexBehaviorTracker.isActive = false;
            document.removeEventListener('mousemove', onIndexMouseMove);
            document.removeEventListener('keydown', onIndexKeyDown);
        }

        async function fetchLatestHR() {
            try {
                const res = await fetch('/api/GameData/latest-hr');
                const data = await res.json();

                if (data.heartRate && data.ageSeconds < 600) {
                    return data.heartRate;
                }

                return null;
            } catch {
                return null;
            }
        }

        document.addEventListener('mousemove', onIndexMouseMove);
        document.addEventListener('keydown', onIndexKeyDown);

        document.getElementById('startBtn').addEventListener('click', async function() {
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const ageText = document.getElementById('age').value.trim();
            const major = document.getElementById('major').value.trim();
            const phoneNumber = document.getElementById('phoneNumber').value.trim();
            const email = document.getElementById('email').value.trim();
            const consentCheckbox = document.getElementById('consentCheckbox');

            if (!firstName || !lastName || !ageText || !major || !phoneNumber || !email) {
                alert('Please fill in all participant details.');
                return;
            }

            if (!consentCheckbox.checked) {
                alert('Please consent to behavior data collection to continue.');
                return;
            }

            const age = parseInt(ageText, 10);
            if (Number.isNaN(age) || age < 1 || age > 120) {
                alert('Please enter a valid age between 1 and 120.');
                return;
            }

            const sessionPayload = {
                firstName,
                lastName,
                age,
                major,
                phoneNumber,
                email,
                indexBehaviorData: buildIndexBehaviorData()
            };

            try {
                const baselineHr = await fetchLatestHR();

                const response = await fetch('/Home/StartSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(sessionPayload)
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    alert(data.error || 'Could not start session. Please check the form and try again.');
                    return;
                }

                sessionStorage.setItem('sessionId', data.sessionId);
                sessionStorage.setItem('userName', `${firstName} ${lastName}`);
                if (baselineHr != null) {
                    sessionStorage.setItem('baselineHeartRate', String(baselineHr));
                } else {
                    sessionStorage.removeItem('baselineHeartRate');
                }
                sessionStorage.removeItem('section1HeartRate');
                sessionStorage.removeItem('section2HeartRate');

                stopIndexBehaviorTracking();
                window.location.href = '/Questions/Section1';
            } catch (error) {
                console.error('Error starting session:', error);
                alert('Error starting session. Please try again.');
            }
        });
    </script>
}
