@{
    ViewData["Title"] = "Session Results";
}

<style>
    body {
        background: linear-gradient(145deg, #0f172a 0%, #1e1b4b 45%, #0b1120 100%);
        min-height: 100vh;
    }

    .results-shell {
        color: #e5e7eb;
        max-width: 1000px;
    }

    .results-title {
        font-weight: 800;
        color: #f8fafc;
        letter-spacing: 0.02em;
    }

    .results-card {
        background: rgba(15, 23, 42, 0.88);
        border: 1px solid rgba(148, 163, 184, 0.25);
        border-radius: 1rem;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);
    }

    .results-card .card-header {
        border-bottom: 1px solid rgba(148, 163, 184, 0.2);
        font-weight: 700;
    }

    .results-card .card-body {
        color: #d1d5db;
    }

    .results-card .table {
        color: #e5e7eb;
        margin-bottom: 0;
    }

    .results-card .table thead th {
        border-color: rgba(148, 163, 184, 0.3);
        color: #93c5fd;
    }

    .results-card .table tbody td {
        border-color: rgba(148, 163, 184, 0.2);
        background: transparent;
    }

    .results-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
</style>

<div class="container py-4 results-shell">
    <h2 class="results-title">Your Session Results</h2>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card results-card">
                <div class="card-header" style="background:linear-gradient(90deg,#2563eb,#06b6d4);color:#fff;">
                    <h5>Session Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>Session ID:</strong> <span id="sessionId"></span></p>
                    <p><strong>User Name:</strong> <span id="userName"></span></p>
                    <p><strong>First Name:</strong> <span id="firstName"></span></p>
                    <p><strong>Last Name:</strong> <span id="lastName"></span></p>
                    <p><strong>Age:</strong> <span id="age"></span></p>
                    <p><strong>Major:</strong> <span id="major"></span></p>
                    <p><strong>Phone Number:</strong> <span id="phoneNumber"></span></p>
                    <p><strong>Email:</strong> <span id="email"></span></p>
                    <p><strong>Start Time:</strong> <span id="startTime"></span></p>
                    <p><strong>Games Played:</strong> <span id="gamesPlayed"></span></p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card results-card">
                <div class="card-header" style="background:linear-gradient(90deg,#16a34a,#22c55e);color:#fff;">
                    <h5>Game Results</h5>
                </div>
                <div class="card-body">
                    <div id="gamesList">
                        <p>Loading games...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12 results-actions">
            <button id="refreshBtn" class="btn btn-primary">Refresh Data</button>
            <button id="deleteSessionBtn" class="btn btn-danger">Delete Session</button>
            <button id="backToGamesBtn" class="btn btn-outline-light">Back to Games</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const sessionId = sessionStorage.getItem('sessionId');
        
        if (!sessionId) {
            window.location.href = '/';
        }
        
        document.getElementById('sessionId').textContent = sessionId;
        
        async function loadSessionData() {
            try {
                const response = await fetch(`/api/GameData/session/${sessionId}/summary`);
                const data = await response.json();
                
                if (data.success) {
                    document.getElementById('userName').textContent = data.userName;
                    document.getElementById('firstName').textContent = data.firstName || '-';
                    document.getElementById('lastName').textContent = data.lastName || '-';
                    document.getElementById('age').textContent = data.age || '-';
                    document.getElementById('major').textContent = data.major || '-';
                    document.getElementById('phoneNumber').textContent = data.phoneNumber || '-';
                    document.getElementById('email').textContent = data.email || '-';
                    document.getElementById('startTime').textContent = new Date(data.startTime).toLocaleString();
                    document.getElementById('gamesPlayed').textContent = data.gamesPlayed;
                    
                    const gamesList = document.getElementById('gamesList');
                    
                    if (data.games && data.games.length > 0) {
                        let html = '<div class="table-responsive"><table class="table">';
                        html += '<thead><tr><th>Game</th><th>Score</th><th>Time (s)</th><th>Completed</th><th>Date</th></tr></thead><tbody>';
                        
                        data.games.forEach(game => {
                            html += `<tr>
                                <td>${game.gameType}</td>
                                <td>${game.score}</td>
                                <td>${game.totalTimeSeconds.toFixed(1)}</td>
                                <td>${game.completed ? '✅' : '❌'}</td>
                                <td>${new Date(game.startTime).toLocaleString()}</td>
                            </tr>`;
                        });
                        
                        html += '</tbody></table></div>';
                        gamesList.innerHTML = html;
                    } else {
                        gamesList.innerHTML = '<div class="alert alert-warning">No games played yet in this session.</div>';
                    }
                } else {
                    gamesList.innerHTML = `<div class="alert alert-danger">Error: ${data.error}</div>`;
                }
            } catch (error) {
                document.getElementById('gamesList').innerHTML = `<div class="alert alert-danger">Error loading data: ${error.message}</div>`;
            }
        }
        
        loadSessionData();
        
        document.getElementById('refreshBtn').addEventListener('click', loadSessionData);

        document.getElementById('deleteSessionBtn').addEventListener('click', async function() {
            if (!confirm('Delete this session and all related game results? This cannot be undone.')) {
                return;
            }

            try {
                const response = await fetch(`/api/GameData/session/${sessionId}`, {
                    method: 'DELETE'
                });

                const data = await response.json();
                if (!data.success) {
                    alert(`Failed to delete session: ${data.error || 'Unknown error'}`);
                    return;
                }

                sessionStorage.removeItem('sessionId');
                alert('Session and related game data deleted successfully.');
                window.location.href = '/';
            } catch (error) {
                alert(`Error deleting session: ${error.message}`);
            }
        });
        
        document.getElementById('backToGamesBtn').addEventListener('click', function() {
            window.location.href = '/Questions/Section1';
        });
    </script>
}